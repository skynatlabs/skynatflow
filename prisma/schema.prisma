// KasiBiz core data model — one shared engine, many niche "skins".
// Party / Item / Transaction / Event, per the strategic report's architecture.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL lives in prisma.config.ts (for Migrate) and is
// passed via an adapter to the PrismaClient constructor (src/lib/db.ts) —
// it's no longer valid inside the schema's datasource block.
datasource db {
  provider = "postgresql"
}

enum PartyRole {
  CUSTOMER
  SUPPLIER
  /// An owner-driver or contractor doing the business's work under its name.
  /// Their lapsed cover is the business's liability, so they get the same
  /// obligation records and the same refusal as an employee.
  SUBCONTRACTOR
  STAFF
  PATIENT // Medical niche — appointment/visit tracking only, no clinical/health data fields
  MEMBER // Non-profit niche
  SPONSOR // Non-profit niche — partners/sponsors, distinct from individual members
}

enum TransactionType {
  QUOTE
  INVOICE
  PAYMENT
  STOCK_ADJUSTMENT
  REFUND
}

enum QuoteKind {
  BASIC // plain line-item quote, no narrative content
  PROPOSAL // adds an intro + scope-of-work section above the line items
}

enum TransactionStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum EventType {
  SITE_VISIT
  DELIVERY
  INSTALL
  STOCK_TRANSFER
  FOLLOW_UP_SENT
  CONSULTATION // Medical niche — an appointment/visit record, non-clinical
  ORDER_PLACED // Ecommerce niche — order confirmed, ahead of fulfillment
  PROPERTY_INSPECTION // Property niche — inspection/maintenance visit
}

enum NicheSkin {
  CORPORATE
  SERVICES
  LOGISTICS
  MEDICAL
  RETAIL
  WHOLESALE
  ECOMMERCE
  NONPROFIT
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Tenant {
  id                           String          @id @default(cuid())
  name                         String
  niche                        NicheSkin       @default(SERVICES)
  // Public booking page config: { enabled, workDays: [1-5], startHour,
  // endHour, slotMins }. Null/absent = booking page not set up yet.
  bookingConfig                Json?
  googleReviewUrl              String? // customer-facing link sent in the post-payment review request
  // Owner-controlled empathy dial on the escalating follow-up engine —
  // chase payment without torching the relationship. Applied to every
  // touch's tone, not just the final one.
  collectionsTone              CollectionsTone @default(STANDARD)
  // Doc backup — daily copy of new documents (signed quotes, filings,
  // lease contracts) to the owner's own cloud storage. Checkpoint: needs
  // real Google OAuth app registration before this does anything beyond
  // logging — same graceful-degradation pattern as WhatsApp/R2.
  docBackupProvider            String? // "google_drive" | null = not connected
  docBackupConnected           Boolean         @default(false)
  // Follow-up cadence, owner-controlled — taking the "when do we nudge
  // them" decision off a person's daily mental checklist entirely.
  // windowDays = days of silence before the first follow-up fires;
  // repeatDays = days between each escalation after that.
  followUpWindowDays           Int             @default(3)
  followUpRepeatDays           Int             @default(3)
  // When on, an AI-drafted follow-up sends automatically instead of
  // waiting in the AiDraft queue for a human Approve click — the
  // confirm-before-send guardrail, made optional per tenant rather than
  // mandatory, since some owners want the daily task gone entirely.
  autoRespondEnabled           Boolean         @default(false)
  // PA voice plan — controls how many characters of premium (Google)
  // voice this tenant gets per period before falling back to free browser
  // voice for the rest of it. "free" = 20,000/month, "starter" =
  // 60,000/month, "unlimited" = 10,000/day (never actually blocks; past
  // the daily allowance it's free browser voice until the day resets).
  voicePlan                    String          @default("free")
  // Banking details shown on invoice PDFs for EFT payment, plus the
  // official WhatsApp number a customer can message to verify a document
  // is genuinely from this business — an anti-impersonation measure, so
  // it's deliberately settable only by an OWNER (see settings/banking),
  // never a capability any staff role gets, to reduce the "a compromised
  // or dishonest staff account swaps the bank account" fraud path.
  // Business details that appear on every document. A valid tax invoice in
  // South Africa has to carry the supplier's name, address and VAT number —
  // the PDF renderer has had fields for these since it was written, and
  // nothing ever populated them, so every invoice this app produced was
  // missing them.
  // Where this business is regulated. Nothing in the compliance engine is
  // hardcoded to a country — these two fields are what select a jurisdiction's
  // obligations out of the shared library, and a workspace in Texas gets Texas
  // rows by the same code path that gives a Johannesburg one CIPC.
  countryCode                  String? // ISO 3166-1 alpha-2: "ZA", "US", "GB"
  // The currency every figure in this workspace is in. ISO 4217. Set from the
  // country at signup; the column default only covers workspaces that predate
  // the field, all of which were South African. Nothing downstream may assume
  // rands — it reads this.
  currency                     String          @default("ZAR")
  // What this business pays for the platform each month, so the value ledger
  // can put what the officers found next to what they cost. Null means it has
  // not been set, which the ledger says rather than showing a saving with no
  // cost beside it.
  monthlyFeeCents              Int?
  // Standing time a customer gets free before detention is billable, and
  // the rate after it. Null rate means detention is measured but not billed.
  detentionFreeMinutes         Int             @default(60)
  detentionRateCents           Int?
  // Turnaround mode: cash first, everything else second. The officers
  // reorder around survival rather than optimisation.
  turnaroundMode               Boolean         @default(false)
  // When the first audit was produced, so it is produced once.
  firstAuditAt                 DateTime?
  // Whether the six officers have introduced themselves yet.
  arrivalShownAt               DateTime?
  /// Where the owner is in moving in: business, details, stock, customers,
  /// look. Null once they finish, or for a workspace that predates it.
  onboardingStep               String?
  onboardedAt                  DateTime?
  /// Stamped by the first quote sent — how long moving in actually took.
  firstQuoteSentAt             DateTime?
  /// Set when the owner asks to delete the business. Everything is removed
  /// once the grace period passes; until then the owner can change their mind.
  deletionRequestedAt          DateTime?
  deletionRequestedById        String?
  regionCode                   String? // state or province, where it changes what you owe: "CA", "TX", "GP"
  // The entity type in the owner's own words — "Pty Ltd", "LLC", "Sole Trader".
  // Deliberately free text: an enum of company types is a geo-lock wearing a
  // different hat.
  entityType                   String?
  businessAddress              String?
  businessEmail                String?
  businessPhone                String?
  vatNumber                    String?
  registrationNumber           String?
  bankName                     String?
  bankAccountHolder            String?
  bankAccountNumber            String?
  bankBranchCode               String?
  bankSwift                    String?
  // How much this workspace lets the agent do on its own. See AgentAutonomy.
  agentAutonomy                AgentAutonomy   @default(SUGGEST_ONLY)
  // Master switch for the proactive layer. Off means the agent only ever
  // responds when spoken to — no tick, no event reactions, no nudges.
  agentProactiveEnabled        Boolean         @default(true)
  /// What the agent may cost this workspace in a month, in cents. Null means
  /// no cap. A cap stops the background work and never stops a person who is
  /// sitting there asking — being told the agent is out of budget mid-question
  /// is a worse outcome than a few cents.
  agentMonthlyCapCents         Int?
  /// Whether this business has agreed to be compared with others in its
  /// trade. Off unless somebody says yes: comparing a business that did not
  /// ask, even anonymously, is using its data for somebody else's benefit.
  benchmarksOptedIn            Boolean         @default(false)
  whatsappVerifyNumber         String?
  // AI-generated proposal content is metered — the LLM call only writes
  // text (never the PDF design/layout, which stays fixed code, both for
  // cost and for visual consistency), but text generation still costs
  // real tokens per call. Simple monthly counter, resets on read once the
  // month rolls over rather than needing a cron job.
  aiProposalGenerationsUsed    Int             @default(0)
  aiProposalGenerationsResetAt DateTime        @default(now())
  createdAt                    DateTime        @default(now())

  memberships            Membership[]
  parties                Party[]
  items                  Item[]
  purchaseOrders         PurchaseOrder[]
  jobCards               JobCard[]
  transactions           Transaction[]
  events                 Event[]
  tasks                  Task[]
  recurringInvoices      RecurringInvoice[]
  comments               Comment[]
  proposalTemplates      ProposalTemplate[]
  aiDrafts               AiDraft[]
  disputes               Dispute[]
  apiKeys                ApiKey[]
  itemBatches            ItemBatch[]
  notes                  Note[]
  goals                  Goal[]
  expenses               Expense[]
  messageThreads         MessageThread[]
  timeEntries            TimeEntry[]
  fuelLogs               FuelLog[]
  stocktakes             Stocktake[]
  insuranceClaims        InsuranceClaim[]
  membershipInvolvements MembershipInvolvement[]
  donations              Donation[]
  complianceFilings      ComplianceFiling[]
  rentals                Rental[]
  properties             Property[]
  leases                 Lease[]
  tillSessions           TillSession[]
  posIntegrations        PosIntegration[]
  paymentGateways        PaymentGateway[]
  paymentCheckouts       PaymentCheckout[]
  ecommerceIntegrations  EcommerceIntegration[]
  calendarIntegration    CalendarIntegration?
  ecommerceOrders        EcommerceOrder[]
  pdfTemplates           TenantPdfTemplate[]
  emailAccounts          EmailAccount[]
  inboundEmails          InboundEmail[]
  notifications          Notification[]
  webhookEndpoints       WebhookEndpoint[]

  connectionsAsSupplier WholesaleConnection[] @relation("SupplierConnections")
  connectionsAsBuyer    WholesaleConnection[] @relation("BuyerConnections")
  agentThreads          AgentThread[]
  agentRuns             AgentRun[]
  tenantFacts           TenantFact[]
  agentDefinitions      AgentDefinition[]
  domainEvents          DomainEvent[]

  obligations Obligation[]

  accounts          Account[]
  journalEntries    JournalEntry[]
  accountingPeriods AccountingPeriod[]

  bankAccounts        BankAccount[]
  reconciliationRules ReconciliationRule[]

  assets            Asset[]
  leaveRequests     LeaveRequest[]
  holidays          Holiday[]
  employmentRecords EmploymentRecord[]

  progressAgreements ProgressAgreement[]

  branches Branch[]

  observations    Observation[]
  officerAutonomy OfficerAutonomy[]

  trips        Trip[]
  tripStops    TripStop[]
  valueEntries ValueEntry[]
  incidents    Incident[]
  fieldSyncs   FieldSync[]
  intakeDocuments IntakeDocument[]
  deliveryNotes   DeliveryNote[]
  outboundEmails  OutboundEmail[]
  portalSubmissions PortalSubmission[]
  agreements        Agreement[]
  connectedSystems  ConnectedSystem[]
  paymentPlans      PaymentPlan[]
  supplierBills     SupplierBill[]
  paymentRuns       PaymentRun[]
  vatReturns        VatReturn[]
  collectionAttempts CollectionAttempt[]
  expenseCodingRules ExpenseCodingRule[]
  contactConsents   ContactConsent[]
  conversations     Conversation[]
  callLogs          CallLog[]
  leadForms         LeadForm[]
  leadSubmissions   LeadSubmission[]
  broadcasts        Broadcast[]
  checklists        Checklist[]
  certificates      Certificate[]
  offlineQueue      OfflineChange[]
  agentUndo         AgentUndo[]
  agentSpend        AgentSpend[]
  agentRecipes      AgentRecipe[]

  @@map("tenants")
}

// A login is global, not scoped to one business — one email, one password,
// any number of businesses. isSuperAdmin is the platform operator's own
// account type: it can see and act across every tenant regardless of
// membership, for support and cross-business oversight. This is distinct
// from an OWNER membership, which only grants access to that one business.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  phone         String? // WhatsApp-reachable — where the daily briefing goes
  // Which accent colour this person sees on buttons, links and key figures.
  // Follows them between workspaces rather than being set per tenant: it is a
  // preference about how somebody likes to look at software, not a property of
  // the business. Null means the default. Deliberately only an accent — the
  // surfaces stay as Admina defines them, so a palette can never make the app
  // unreadable.
  accentPalette String?
  passwordHash  String? // null = account exists (e.g. added by a staff invite) but hasn't been claimed with a password yet
  isSuperAdmin  Boolean  @default(false)
  totpSecret    String? // base32, set once 2FA setup is confirmed
  totpEnabled   Boolean  @default(false)
  createdAt     DateTime @default(now())

  memberships Membership[]

  @@map("users")
}

// Join table: which businesses a login can access, and what they can do in
// each one. The same person can be OWNER of one business and STAFF of
// another — e.g. a wholesaler's owner who is also a retailer's buyer-side
// contact. Role granularity (OWNER/STAFF/DRIVER/REP/TECHNICIAN) matches the
// Role type in src/lib/core/access.ts.
model Membership {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  role       String       @default("OWNER") // OWNER | STAFF | DRIVER | REP | TECHNICIAN
  // Org hierarchy — additive on top of the per-staff account that already
  // existed (Membership = one person's account on one business). Optional:
  // a flat team with no managers set is still perfectly valid.
  managerId  String?
  manager    Membership?  @relation("ManagerOf", fields: [managerId], references: [id])
  reports    Membership[] @relation("ManagerOf")
  department String?
  createdAt  DateTime     @default(now())

  transactionsAsSalesPerson Transaction[]
  jobCardsAssigned          JobCard[]

  obligations Obligation[]

  assetsHeld        Asset[]            @relation("AssetHolder")
  leaveRequests     LeaveRequest[]     @relation("LeaveTaker")
  employmentRecords EmploymentRecord[] @relation("EmploymentSubject")

  // Where this person normally works.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // What an hour of this person costs the business, including on-costs — the
  // number labour apportionment needs and the one nobody can reconstruct
  // later. Not their pay: their cost. Owner-visible only.
  costRateCents Int?
  // When this person agreed to have their movement recorded from the phone.
  // No trip points are accepted for a membership without it. Consent is a
  // dated fact, not a checkbox that defaults on.
  locationConsentAt DateTime?

  tripsDriven Trip[] @relation("TripDriver")

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

enum JobCardStatus {
  SCHEDULED
  IN_PROGRESS
  DONE
}

// A work order for a service business — "job cards" per the user's own
// term (solar install crews, contractors). Deliberately linked to a
// Transaction (usually the ACCEPTED quote/invoice) rather than floating
// free, since a job card's whole point is "the physical work behind this
// sale" — pricing/line-items stay on the Transaction, this only tracks
// getting the work done. A checklist (JobCardTask) covers the common
// "make sure every step actually happened" need without inventing a
// separate generic task system.
model JobCard {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  transactionId      String
  transaction        Transaction   @relation(fields: [transactionId], references: [id])
  partyId            String
  party              Party         @relation(fields: [partyId], references: [id])
  title              String
  assignedToId       String?
  assignedTo         Membership?   @relation(fields: [assignedToId], references: [id])
  status             JobCardStatus @default(SCHEDULED)
  scheduledAt        DateTime?
  notes              String?
  completionPhotoUrl String?
  createdAt          DateTime      @default(now())
  completedAt        DateTime?

  // ---- the day, and what it costs ------------------------------------
  //
  // Scheduling a job needs three things a date alone cannot give: how long it
  // takes, where it is, and what order the day runs in. Without the first two
  // a dispatch board can only stack jobs on a date and hope; without the third
  // a driver gets a list rather than a route.
  /// How long it is expected to take. The number capacity planning divides by.
  estimatedMinutes   Int?
  /// Where it happens, when that is not the customer's own address.
  siteAddress        String?
  siteLat            Float?
  siteLng            Float?
  /// Position within its day, once somebody has put the day in order.
  routeOrder         Int?
  /// What was expected to be spent on it. Compared against what was.
  budgetCents        Int?
  /// A subcontractor doing it instead of somebody on the team.
  subcontractorId    String?
  subcontractor      Party?        @relation("JobCardSubcontractor", fields: [subcontractorId], references: [id])
  /// What the sub is being paid, which is not what the customer is charged.
  subcontractCents   Int?
  /// The checklist this job was started from, so it can be told what is missing.
  checklistId        String?
  checklist          Checklist?    @relation(fields: [checklistId], references: [id])
  /// Jobs this one cannot start before. A dependency, for the timeline view.
  dependsOnId        String?
  dependsOn          JobCard?      @relation("JobCardOrder", fields: [dependsOnId], references: [id])
  blocks             JobCard[]     @relation("JobCardOrder")
  certificates       Certificate[]

  tasks       JobCardTask[]
  expenses    Expense[]
  tripStops   TripStop[]
  timeEntries TimeEntry[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("job_cards")
}

model JobCardTask {
  id        String  @id @default(cuid())
  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id])
  label     String
  isDone    Boolean @default(false)
  sortOrder Int     @default(0)

  @@map("job_card_tasks")
}

// People: customers, suppliers, staff — one address book, one table.
model Party {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  role        PartyRole
  name        String
  phone       String? // WhatsApp-reachable number, E.164
  email       String?
  notes       String?
  // Richer contact/mapping fields for a proper customer record, not just
  // a name+number — printed on quotes/invoices and usable in reporting.
  companyName String?
  vatNumber   String?
  addressLine String?
  city        String?
  postalCode  String?
  country     String?
  // Customer portal — a token-login link (Soler's proven pattern,
  // generalized onto the shared Party model), no password needed. Lazily
  // generated the first time a portal link is requested for this party.
  portalToken String?   @unique
  createdAt   DateTime  @default(now())

  transactions             Transaction[]
  events                   Event[]
  recurringInvoices        RecurringInvoice[]
  aiDrafts                 AiDraft[]
  disputes                 Dispute[]
  membershipInvolvements   MembershipInvolvement[]
  donations                Donation[]
  rentals                  Rental[]
  leasesAsRenter           Lease[]
  purchaseOrdersAsSupplier PurchaseOrder[]
  jobCards                 JobCard[]

  obligations Obligation[]

  progressAgreements ProgressAgreement[]

  expensesAsSupplier Expense[]  @relation("ExpenseSupplier")
  tripStops          TripStop[]
  tripsSubcontracted Trip[]      @relation("TripSubcontractor")

  // The language this customer's documents and messages go out in. Null means
  // the workspace default. An ISO 639-1 code rather than an enum, because a
  // fixed list of languages is the same mistake as a fixed list of countries.
  language String?

  /// The currency this customer is billed in. Null means the workspace's own.
  /// Set here rather than per document so a customer who pays in dollars is
  /// quoted in dollars without anybody remembering to switch it each time.
  currency String?

  deliveryNotes DeliveryNote[]
  inboundEmails InboundEmail[]
  outboundEmails OutboundEmail[]
  portalSubmissions PortalSubmission[]
  agreements        Agreement[]
  supplierBills     SupplierBill[]
  collectionAttempts CollectionAttempt[]
  contactConsents   ContactConsent[]
  conversations     Conversation[]
  callLogs          CallLog[]
  leadSubmissions   LeadSubmission[]
  jobCardsSubcontracted JobCard[] @relation("JobCardSubcontractor")
  certificates      Certificate[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("parties")
}

// Items: stock, services, catalog entries — shared across retail/wholesale/services.
model Item {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  name            String
  // The explanatory line printed under the item name on a document — what it
  // is, what it includes, which standard it complies with. The PDF renderer
  // has a column switch for these; without somewhere to write them it would
  // be a switch that does nothing.
  description     String?
  // "m", "pcs", "hours" — printed under the quantity on a document.
  unit            String?
  sku             String?
  hsnCode         String? // HSN/tax-classification code, shown alongside SKU on the line item
  unitPriceCents  Int
  costCents       Int? // for margin reporting — optional, owner may not track cost
  taxRatePercent  Int? // e.g. 15 for 15% VAT; null = no tax applied
  category        String?
  imageUrl        String?
  isActive        Boolean         @default(true) // soft-hide from the catalog picker without deleting history
  stockQty        Int? // null = service line item, not stock-tracked
  reorderPoint    Int?
  minOrderQty     Int? // wholesale MOQ — null = no minimum enforced
  // Rentals — platform-wide, not tied to one niche. An Item can be
  // rentable instead of (or as well as) sellable.
  isRentable      Boolean         @default(false)
  rentalRateCents Int?
  rentalRateUnit  RentalRateUnit?
  createdAt       DateTime        @default(now())

  transactionLines   TransactionLine[]
  batches            ItemBatch[]
  purchaseOrderLines PurchaseOrderLine[]
  stocktakes         Stocktake[]
  rentals            Rental[]
  expenseLines       ExpenseLine[]
  deliveryNoteLines  DeliveryNoteLine[]

  obligations Obligation[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("items")
}

// Optional per-batch stock tracking, additive on top of Item.stockQty —
// only needed for perishable/expiring inventory (FEFO waste reduction).
// Items that never set a batch just don't get expiry-risk tracking.
model ItemBatch {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  itemId     String
  item       Item      @relation(fields: [itemId], references: [id])
  quantity   Int
  receivedAt DateTime  @default(now())
  expiresAt  DateTime? // null = non-perishable, not tracked for waste risk
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([itemId, expiresAt])
  @@map("item_batches")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
}

// PA job: turning a reorder suggestion (src/lib/core/inventory.ts
// getReorderSuggestions) into a real, sendable document instead of just
// a number on a dashboard. Deliberately its own model, not a Transaction
// row — a PO is a commitment to a supplier, not a sale, and mixing it
// into the sales ledger would break every report that sums Transaction
// amounts as revenue.
model PurchaseOrder {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  supplierId     String
  supplier       Party               @relation(fields: [supplierId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  totalCostCents Int
  createdAt      DateTime            @default(now())
  sentAt         DateTime?
  receivedAt     DateTime?

  lines PurchaseOrderLine[]

  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])
  quantity        Int
  unitCostCents   Int

  @@map("purchase_order_lines")
}

// Money: append-only ledger. Quotes, invoices, payments — one typed table,
// never mutated after creation, only superseded by a new row referencing it.
model Transaction {
  id                      String            @id @default(cuid())
  tenantId                String
  tenant                  Tenant            @relation(fields: [tenantId], references: [id])
  partyId                 String
  party                   Party             @relation(fields: [partyId], references: [id])
  type                    TransactionType
  status                  TransactionStatus @default(DRAFT)
  amountCents             Int
  parentId                String? // e.g. an INVOICE points back at the QUOTE it came from
  parent                  Transaction?      @relation("TransactionLineage", fields: [parentId], references: [id])
  children                Transaction[]     @relation("TransactionLineage")
  createdAt               DateTime          @default(now())
  dueAt                   DateTime?
  respondedAt             DateTime? // when the customer last replied/acted — drives the follow-up engine
  signatureDataUrl        String? // customer's e-signature on quote acceptance, captured via the portal
  // Acceptance audit trail — the difference between "we have a drawn
  // signature" and "this holds up as a real contract record." The hash
  // binds the amount/lines/signature/timestamp together so any later
  // tampering with the quote is detectable by recomputing and comparing.
  acceptanceIp            String?
  acceptanceHash          String?
  reviewRequestSentAt     DateTime? // fires once, the moment an invoice first reaches PAID
  // Who this quote/invoice is attributed to — shown on the document (with
  // their contact details, if the tenant opts in) so the customer knows
  // exactly who to reach, and lets reporting break down sales by person.
  salesPersonMembershipId String?
  salesPersonMembership   Membership?       @relation(fields: [salesPersonMembershipId], references: [id])
  // Whole-document discount, applied on top of the line-level discounts —
  // matches the "Discount %" field on the totals block of most invoicing
  // tools. amountCents already reflects this once applied; kept here too
  // so the PDF/online view can show the breakdown, not just the result.
  discountPercent         Float?            @default(0)
  // The document's number in the system it was imported from — Zoho's
  // Estimate Number, QuickBooks' Num. What makes re-running an import fill in
  // what is missing on documents already here, instead of duplicating them.
  externalRef             String?
  // The currency this document is in, and the rate to the workspace's own
  // currency frozen at issue — so a paid invoice never silently restates.
  // Null means the workspace currency at 1:1.
  currency                String?
  fxRateToBase            Float?
  // Free-text business fields shown on the document alongside the line
  // items — subject line and a PO/reference number, the two fields every
  // real invoicing tool has that this one didn't.
  subject                 String?
  poNumber                String?
  // Quote presentation (BASIC vs PROPOSAL). Only meaningful on QUOTE rows;
  // introText/scopeOfWork are populated for PROPOSAL and shown above the
  // line items on both the web link and the PDF.
  quoteKind               QuoteKind?        @default(BASIC)
  introText               String?
  scopeOfWork             String?
  // Extra fields for a PROPOSAL-kind quote's project info — populated by
  // AI (src/lib/ai/proposal.ts) from the line items plus projectLocation,
  // the one field a human has to actually type in. The AI only ever
  // writes text into these fields; the PDF layout/design is fixed code,
  // never generated, so this stays fast, cheap, and visually consistent.
  projectLocation         String?
  performanceExpectancy   String?
  projectTimeline         String?
  systemInfo              String?
  // Quote-open tracking (Soler's hot-lead pattern): a customer opening the
  // portal link for a quote is a buying signal, tracked independent of
  // whether they've responded yet.
  openCount               Int               @default(0)
  firstOpenedAt           DateTime?
  lastOpenedAt            DateTime?
  // POS checkout — only set on PAYMENT rows recorded at a till.
  paymentMethod           String? // "cash" | "card" | provider id, e.g. "yoco"
  tillSessionId           String?
  tillSession             TillSession?      @relation(fields: [tillSessionId], references: [id])
  // Overrides the default follow-up cadence when an inbound email reply
  // gave a real scheduling cue ("call me back in 2 weeks") — the
  // follow-up cron checks this before falling back to
  // Tenant.followUpWindowDays/followUpRepeatDays.
  nextFollowUpAt          DateTime?
  // Owner-set context for a manual reminder ("said he'll be ready in 2
  // months") — shown next to the quote and on the This Week board so the
  // reminder isn't just a bare date with no memory of why.
  followUpNote            String?
  // Google Calendar event id for this reminder, if the tenant has
  // connected a calendar — lets setManualReminder update the existing
  // event instead of creating a duplicate, and clearManualReminder
  // delete it instead of leaving an orphaned calendar entry.
  calendarEventId         String?

  itemLines        TransactionLine[]
  paymentCheckouts PaymentCheckout[]
  ecommerceOrder   EcommerceOrder?
  jobCards         JobCard[]

  obligations Obligation[]
  expenses      Expense[]
  tripStops     TripStop[]
  deliveryNotes DeliveryNote[]
  portalSubmissions PortalSubmission[]
  agreements        Agreement[]
  paymentPlan       PaymentPlan?
  collectionAttempts CollectionAttempt[]

  // Which branch this was sold from. Null on a single-site business.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type, status])
  @@index([tenantId, type, externalRef])
  @@map("transactions")
}

model TransactionLine {
  id              String      @id @default(cuid())
  transactionId   String
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  itemId          String
  item            Item        @relation(fields: [itemId], references: [id])
  quantity        Int
  unitPriceCents  Int
  // Snapshotted at the time this line was added, not read live off Item —
  // so a later change to the catalog's tax rate never silently rewrites
  // the tax on a quote/invoice that already went out.
  discountPercent Float?      @default(0)
  taxRatePercent  Float?
  /// What this line says on the document, when it should not simply be the
  /// product's name — "Delivery, 12 pallets, Johannesburg to Durban".
  description     String?
  /// How it is sold: each, hour, kg, pallet. Printed beside the quantity.
  unit            String?
  /// The order the lines are printed in; a document is a sequence, not a set.
  sortOrder       Int         @default(0)

  @@index([transactionId])
  @@map("transaction_lines")
}

// Movement: deliveries, site visits, installs, stock transfers, follow-ups sent.
model Event {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  partyId       String?
  party         Party?    @relation(fields: [partyId], references: [id])
  transactionId String? // which quote/invoice this event relates to, e.g. a FOLLOW_UP_SENT
  type          EventType
  notes         String?
  photoUrl      String?
  signedByUrl   String?
  gpsLat        Float?
  gpsLng        Float?
  scheduledAt   DateTime? // when this is a booked appointment (CONSULTATION/SITE_VISIT), the slot time — null for events logged after the fact
  // Marked by a human after the fact — the PA can't infer a no-show on its
  // own (a passed appointment with no linked invoice is just as often
  // "hasn't billed yet"), so this stays a deliberate action that then
  // triggers the automatic rebooking nudge (src/lib/core/reminders.ts).
  noShow        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  // The stop on a trip this was the proof for, when it was.
  tripStop TripStop?

  @@index([tenantId])
  @@index([transactionId])
  @@index([tenantId, scheduledAt])
  @@map("events")
}

// Cross-tenant connection: lets a WHOLESALE-niche tenant and a RETAIL-niche
// (or any) tenant trade directly inside the app, per the strategic report's
// Section 11 — the wholesaler-retailer network layer. Orders placed across
// a connection still just create ordinary Transaction rows on each side;
// this model only tracks who's allowed to trade with whom and on what terms.
model WholesaleConnection {
  id               String           @id @default(cuid())
  supplierTenantId String
  supplierTenant   Tenant           @relation("SupplierConnections", fields: [supplierTenantId], references: [id])
  buyerTenantId    String
  buyerTenant      Tenant           @relation("BuyerConnections", fields: [buyerTenantId], references: [id])
  status           ConnectionStatus @default(PENDING)
  // Optional discount off the supplier's standard item price for this buyer —
  // the tiered/contract pricing requirement from the strategic report's
  // wholesale section, kept simple (a flat percentage) rather than
  // per-item tiers, which is a natural Phase 9 extension once real
  // wholesale customers ask for it.
  discountPercent  Float?
  // Null = no limit enforced. Checked against the buyer's outstanding
  // balance on the supplier's books before a new connected order is
  // accepted — the credit-risk gap identified in the wholesale pain-point
  // research (orders placed with no visibility into buyer credit exposure).
  creditLimitCents Int?
  createdAt        DateTime         @default(now())

  @@unique([supplierTenantId, buyerTenantId])
  @@index([supplierTenantId])
  @@index([buyerTenantId])
  @@map("wholesale_connections")
}

// Phase 8 hardening: every mutating action through the Business Graph API
// leaves a trace here — who (actor), what (capability), on what (target),
// and when. This is the audit trail that makes AI-taken actions reviewable,
// per the trust/reversibility principle in the strategic report (6.4).
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorType  String // "user" | "ai" | "system"
  actorId    String? // User.id when actorType is "user"
  capability String // e.g. "quote:create"
  targetType String // e.g. "Transaction"
  targetId   String
  metadata   String? // small JSON blob, kept as text to avoid a Json-type dependency
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// Team task/project management — deliberately simple (one flat list, three
// states) rather than a full project-management suite, per the "must be
// easy to use" instruction. Real workflow automation happens through the
// AI/follow-up engine (src/lib/ai, src/app/api/cron), not a visual
// rule-builder here — consistent with the platform's AI-first stance
// against Zapier-style no-code builders that still require developer-style
// thinking to configure.
model Task {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  title       String
  description String?
  status      TaskStatus @default(TODO)
  assigneeId  String? // Membership.id — assigned to a specific person's role on this tenant
  partyId     String? // optional link to the customer/deal this task is about
  dueAt       DateTime?
  createdAt   DateTime   @default(now())

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tasks")
}

// Reusable proposal starter text — pick one when building a PROPOSAL-kind
// quote instead of retyping the intro/scope every time. Deliberately just
// two text blocks, matching what QuoteKind.PROPOSAL actually renders.
model ProposalTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  introText   String?
  scopeOfWork String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("proposal_templates")
}

// Internal team comments on any record — a customer, a quote, a task —
// polymorphic by (entityType, entityId) rather than a table per entity,
// since the shape (who said what, when) never varies. @mentions are
// stored as plain text (@Name) and rendered highlighted; no push
// notification wiring yet, just visible to anyone viewing the record.
model Comment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  entityType String // "Party" | "Transaction" | "Task"
  entityId   String
  authorId   String // Membership.id
  body       String
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("comments")
}

// Public API access — the piece that unlocks Zapier and any other
// external integration without needing a partnership with anyone. Keys
// act with full read/write on their own tenant; only the hash is stored,
// the plaintext key is shown exactly once at creation.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  keyPrefix  String    @unique // shown in the list so a key is identifiable without re-revealing it
  keyHash    String    @unique
  // A key carries a Role rather than its own permission list. The app already
  // has one permission model (Role -> Capability, lib/core/access.ts) and
  // every core function is written against it; a second, parallel scheme for
  // API callers would be two things to keep in step, and the one that drifts
  // is always the one nobody is looking at.
  role       String    @default("STAFF") // OWNER | STAFF | DRIVER | REP | TECHNICIAN, as on Membership
  // May read whatever its role can see, and write nothing. The common case
  // for dashboards, exports, and anything that runs in a browser.
  readOnly   Boolean   @default(false)
  expiresAt  DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  // Fixed-window rate limiting, counted on the row. In-memory counters are
  // per-instance and therefore meaningless once this runs on more than one
  // machine; one extra write per request is the honest price of a limit that
  // actually holds.
  windowStart DateTime @default(now())
  windowCount Int      @default(0)

  @@index([tenantId])
  @@map("api_keys")
}

// Outbound event notifications — the other half of "integrate with
// anything." Delivered with an HMAC-SHA256 signature (X-Flow-Signature
// header) so the receiver can verify authenticity.
model WebhookEndpoint {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  url       String
  secret    String
  events    String[] // e.g. ["quote.created", "quote.accepted", "invoice.paid", "dispute.raised"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String          @id @default(cuid())
  endpointId  String
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event       String
  payload     Json            @default("{}")
  statusCode  Int?
  error       String?
  // Retry bookkeeping. A delivery that never lands has to stay visible rather
  // than being dropped — "we sent it" is a claim someone eventually checks.
  attempts    Int             @default(0)
  status      String          @default("PENDING") // PENDING | DELIVERED | FAILED
  nextAttempt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([endpointId])
  @@index([status, nextAttempt])
  @@map("webhook_deliveries")
}

enum CollectionsTone {
  GENTLE
  STANDARD
  FIRM
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

// A real path for "this isn't right" — most CRMs have zero structured way
// to handle pushback, which is exactly where trust is won or lost. Raised
// by the customer from the portal, resolved by the owner from the
// dashboard, tracked start to finish instead of living in a WhatsApp thread.
model Dispute {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  transactionId  String
  partyId        String
  party          Party         @relation(fields: [partyId], references: [id])
  message        String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  @@index([tenantId, status])
  @@index([transactionId])
  @@map("disputes")
}

enum AiDraftStatus {
  PENDING
  SENT
  SKIPPED
}

// The confirm-before-send guardrail, made real: every AI-drafted
// customer-facing message lands here first, with the reasoning behind its
// tone visible, instead of being sent straight from the cron job. Nothing
// leaves without a human clicking Approve (or Skip).
model AiDraft {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  partyId       String
  party         Party         @relation(fields: [partyId], references: [id])
  transactionId String
  touchNumber   Int
  body          String
  reasoning     String // one line: why this tone/timing was chosen
  status        AiDraftStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  resolvedAt    DateTime?

  @@index([tenantId, status])
  @@map("ai_drafts")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
}

// A standing instruction to auto-generate + send an invoice on a schedule
// — line items are a snapshot (not live catalog references) so editing a
// product later doesn't silently change a subscription's price. The cron
// route is the only writer of nextRunAt; everything else just reads it.
model RecurringInvoice {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  partyId   String
  party     Party               @relation(fields: [partyId], references: [id])
  frequency RecurrenceFrequency
  dueInDays Int                 @default(14)
  isActive  Boolean             @default(true)
  lines     Json // snapshot: [{ itemId, name, quantity, unitPriceCents }]
  nextRunAt DateTime
  lastRunAt DateTime?
  createdAt DateTime            @default(now())

  @@index([tenantId])
  @@index([isActive, nextRunAt])
  @@map("recurring_invoices")
}

// The flow/Skynat marketing site itself (not a tenant's business) —
// platform-global, editable only by super-admins via /admin. One row per
// page (keyed by slug), each with an ordered list of sections. Section
// shape is deliberately generic (heading/body/image/items) rather than a
// free block builder — src/lib/cms/pageTemplates.ts is the single source
// of truth for which sections exist on which page and how each renders.
model PageContent {
  id              String   @id @default(cuid())
  slug            String   @unique // "home", "about", "ai-agents", "industry-SERVICES", ...
  title           String
  metaDescription String?
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  sections PageSection[]

  @@map("page_contents")
}

model PageSection {
  id         String      @id @default(cuid())
  pageId     String
  page       PageContent @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key        String // matches the slot key in pageTemplates.ts, e.g. "hero", "benefits_grid"
  heading    String?
  subheading String?
  body       String?
  imageUrl   String?
  ctaLabel   String?
  ctaHref    String?
  // Repeatable sub-items for grid/testimonials/logos/cards sections:
  // [{ title, body, imageUrl, href, name, role }, ...] — shape varies by
  // section type, interpreted by SectionRenderer per pageTemplates.ts.
  items      Json?
  order      Int         @default(0)

  @@unique([pageId, key])
  @@map("page_sections")
}

model Note {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  entityType String // "Party" | "Transaction" | "Task" | "Tenant" (general note)
  entityId   String?
  authorId   String // Membership.id
  title      String?
  body       String
  /// "team" — everyone in the workspace sees it; "private" — only the author.
  audience   String   @default("team")
  /// Membership ids named in the note, each of whom is told about it.
  mentions   String[] @default([])
  pinned     Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, pinned])
  @@map("notes")
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  ACHIEVED
  MISSED
}

model Goal {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  ownerId      String? // Membership.id — null = whole-company goal
  title        String
  metricLabel  String // e.g. "Revenue", "New customers"
  targetValue  Float
  currentValue Float      @default(0)
  dueDate      DateTime?
  status       GoalStatus @default(ON_TRACK)
  createdAt    DateTime   @default(now())

  @@index([tenantId])
  @@map("goals")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  /// Recognised as the same spend as another row that arrived by a different
  /// route — the slip photographed on Monday and the bank line on Wednesday.
  /// Kept rather than deleted so the second arrival is visible, and never
  /// counted anywhere.
  DUPLICATE
}

/// How a cost reached the system. Every route is a first-class citizen
/// because the alternative is a business whose books hold the desktop-entered
/// two thirds and nothing else.
enum ExpenseSource {
  DESKTOP
  CAMERA
  UPLOAD
  EMAIL
  BANK_FEED
  CARD_STATEMENT
  STAFF_APP
  IMPORT
  AGENT
}

/// What one unit of an asset's capacity is: a kilometre for a vehicle, an
/// hour for a machine, a day for a crew. The denominator of every "cost per"
/// figure, chosen once per asset rather than guessed per report.
enum CapacityUnit {
  KM
  HOUR
  DAY
}

enum TripStatus {
  PLANNED
  UNDERWAY
  DONE
  CANCELLED
}

enum TripPurpose {
  DELIVERY
  COLLECTION
  SITE_VISIT
  APPOINTMENT
  TRANSFER
  OTHER
}

/// Where a distance figure came from, kept next to the figure. An odometer
/// pair and a typed guess are not the same kind of number, and a cost per
/// kilometre built on the second should say so.
enum DistanceSource {
  ODOMETER
  GPS
  TYPED
  ESTIMATED
}

/// The value ledger's four kinds of line. IDENTIFIED is what an officer found
/// and put in front of somebody; ACCEPTED is what the owner said yes to;
/// REALISED is what can be verified afterwards in the data; COST is what the
/// platform charged. The gap between the first three is the honesty.
enum ValueKind {
  IDENTIFIED
  ACCEPTED
  REALISED
  COST
}


model Expense {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  submittedById   String // Membership.id
  category        String?
  descriptionText String
  amountCents     Int
  receiptDataUrl  String? // optional attached slip — same base64 pattern as e-signatures
  status          ExpenseStatus @default(PENDING)
  // Money the owner took out of the business for themselves, rather than a
  // cost of running it. They come off the same card and look identical on a
  // statement, which is why most small businesses cannot say what their real
  // costs are — and why drawings booked as expenses make a profitable
  // business look like it is barely breaking even.
  //
  // Null is a real third state: nobody has said yet. It is what the agent
  // asks about, and collapsing it into false would hide every unreviewed row.
  isOwnerDrawing  Boolean?
  approvedById    String?
  createdAt       DateTime      @default(now())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // ---- where, how and what for ---------------------------------------
  //
  // Every cost is tagged the moment it is recorded, because the moment it is
  // recorded is the only time anybody knows. Cost per kilometre, margin per
  // job and the consolidation engine all divide by these; a slip that arrives
  // without them is a rand that can never be apportioned.

  // The day the money left, which is not the day the slip was photographed.
  spentOn DateTime @default(now())
  source  ExpenseSource @default(DESKTOP)

  // Who was paid. A linked supplier when there is one; the name off the slip
  // when there is not, so consolidation can still group by it.
  supplierId   String?
  supplier     Party?  @relation("ExpenseSupplier", fields: [supplierId], references: [id])
  supplierName String?
  // Tax included in amountCents, when the slip shows it.
  taxCents     Int?
  // The slip or invoice number. The strongest duplicate signal there is.
  reference    String?

  // The ledger account this codes to, once somebody or something has said.
  // Free-text category stays for what it always was: a hint.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  // What the cost was for. Any, all or none — a fuel slip is for a vehicle
  // and a trip; a bag of cement is for a job; a coffee is for nobody.
  assetId       String?
  asset         Asset?       @relation(fields: [assetId], references: [id])
  tripId        String?
  trip          Trip?        @relation(fields: [tripId], references: [id])
  jobCardId     String?
  jobCard       JobCard?     @relation(fields: [jobCardId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  // Who actually spent it, when that is not who typed it in. Membership.id.
  incurredById  String?

  // How much of what, for anything bought by the litre, the metre or the
  // hour. Unit price is what supplier consolidation compares.
  quantity Float?
  unit     String?
  // The reading on the dash when this was a fuel stop. Odometer readings are
  // the backbone of every distance figure, and a fuel slip is where they get
  // captured without anybody being asked to.
  odometerKm Int?

  // A cost the customer should pay back — a toll, a permit, materials bought
  // for their job. Set at capture; cleared onto an invoice line once billed.
  recoverable   Boolean      @default(false)
  recoveredOnId String?

  // Same supplier, same amount, same day — the shape a second arrival takes.
  fingerprint   String?
  // Set when this looks like, or is, the same spend as another row.
  duplicateOfId String?

  // What the machine read off the slip, kept apart from the fields a person
  // may have corrected, so a correction never loses what was seen.
  receiptReading Json?
  receiptReadAt  DateTime?

  lines   ExpenseLine[]
  fuelLog FuelLog?

  @@index([tenantId, status])
  @@index([tenantId, spentOn])
  @@index([tenantId, fingerprint])
  @@index([tenantId, assetId])
  @@index([tenantId, supplierId])
  @@index([tenantId, transactionId])
  @@map("expenses")
}

/// A line off a slip. What was bought, how many, at what. This is the row
/// supplier consolidation reads — "the same goods from four suppliers at four
/// prices" is a comparison of these, and nothing coarser can make it.
model ExpenseLine {
  id          String  @id @default(cuid())
  expenseId   String
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  description String
  quantity    Float   @default(1)
  unit        String?
  unitCents   Int
  totalCents  Int
  // Matched to the catalogue when it can be — the same goods should be the
  // same item, whoever sold them.
  itemId      String?
  item        Item?   @relation(fields: [itemId], references: [id])
  sortOrder   Int     @default(0)

  @@index([expenseId])
  @@index([itemId])
  @@map("expense_lines")
}

// A Thread is either a DM (two participantIds), a named group, or scoped
// to a Task (job card). Polling-based reads for v1 — no websocket infra
// in this stack yet, and the rest of the dashboard already works this way
// (server components + revalidatePath), so this stays consistent with it.
model MessageThread {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String? // set for group threads, null for a DM
  taskId         String? // optional: scoped to a job card/project task
  participantIds String[] // Membership.id[]
  createdAt      DateTime @default(now())

  messages Message[]

  @@index([tenantId])
  @@map("message_threads")
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id])
  authorId  String // Membership.id
  body      String
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
  @@map("messages")
}

model TimeEntry {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  membershipId String // who clocked in
  clockInAt    DateTime  @default(now())
  clockOutAt   DateTime?
  notes        String?
  /// The job these hours were on. Clocking on to a day says somebody was at
  /// work; clocking on to a job is what lets the hours be costed against it.
  jobCardId    String?
  jobCard      JobCard?  @relation(fields: [jobCardId], references: [id])

  @@index([tenantId, membershipId])
  @@map("time_entries")
}

model FuelLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  driverId   String // Membership.id
  odometerKm Int?
  litres     Float
  costCents  Int
  loggedAt   DateTime @default(now())
  notes      String?

  // Which vehicle was filled. A fuel log with no vehicle is a litre count
  // that cannot become a cost per kilometre.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])
  // The expense this fill-up is. Fuel logged here used to be money the books
  // never saw; now one capture writes both, and this is the link.
  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id])

  @@index([tenantId, driverId])
  @@index([tenantId, assetId])
  @@map("fuel_logs")
}

// ---------------------------------------------------------------------------
// Trips
//
// The object every logistics calculation hangs from, and the one that was
// genuinely absent. A trip is a vehicle (or a person, or a machine) doing a
// run: where from, where to, how far, how long, who drove, what it stopped
// for. Fuel and tolls hang off it; the invoices it delivered hang off its
// stops; cost per kilometre divides by its distance. For a business that is
// not a logistics company it is still the truth about an electrician driving
// to four jobs — which is a fleet cost they do not know they have.
// ---------------------------------------------------------------------------

model Trip {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  status   TripStatus  @default(PLANNED)
  purpose  TripPurpose @default(OTHER)

  // Which asset made the run. Null for a run on foot or in a private car,
  // which is still a run with a cost.
  assetId  String?
  asset    Asset?      @relation(fields: [assetId], references: [id])
  driverId String?
  driver   Membership? @relation("TripDriver", fields: [driverId], references: [id])
  // An owner-driver doing the run instead of an employee.
  subcontractorId String?
  subcontractor   Party?  @relation("TripSubcontractor", fields: [subcontractorId], references: [id])

  originText      String?
  originLat       Float?
  originLng       Float?
  destinationText String?
  destinationLat  Float?
  destinationLng  Float?
  // Origin and destination normalised into one key, so "Johannesburg to
  // Durban" and "JHB → DBN" are the same lane in every report.
  laneKey         String?

  plannedAt DateTime?
  startedAt DateTime?
  endedAt   DateTime?
  // What the run was expected to be, so a deviation can be judged.
  plannedKm Float?

  odometerStartKm Int?
  odometerEndKm   Int?
  // The distance figure everything divides by, and where it came from.
  distanceKm     Float?
  distanceSource DistanceSource?

  notes     String?
  createdAt DateTime @default(now())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  stops     TripStop[]
  points    TripPoint[]
  expenses  Expense[]
  incidents Incident[]

  @@index([tenantId, status])
  @@index([tenantId, assetId, startedAt])
  @@index([tenantId, driverId, startedAt])
  @@index([tenantId, laneKey])
  @@map("trips")
}

/// Somewhere a trip went. A load, in the logistics sense, is a stop with an
/// invoice on it. Arrival and departure are the proof-of-work times; the
/// event is the photograph or signature.
model TripStop {
  id       String @id @default(cuid())
  tripId   String
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  sequence Int

  partyId       String?
  party         Party?       @relation(fields: [partyId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  jobCardId     String?
  jobCard       JobCard?     @relation(fields: [jobCardId], references: [id])

  label       String?
  addressText String?
  lat         Float?
  lng         Float?

  plannedAt  DateTime?
  arrivedAt  DateTime?
  departedAt DateTime?
  // Weight on or off at this stop, for load planning. Positive loads, negative drops.
  loadKg     Int?
  // The invoice line detention at this stop was billed on, once it was.
  detentionBilledOnId String?

  // The delivery, site visit or install this stop produced, with its proof.
  eventId String? @unique
  event   Event?  @relation(fields: [eventId], references: [id])

  @@index([tripId, sequence])
  @@index([tenantId, transactionId])
  @@index([tenantId, partyId])
  @@map("trip_stops")
}

/// A position along a trip, from the phone, with the person's consent. Only
/// the distance is ever derived from these; the points themselves are the
/// person's business and are exported to them, not reported on.
model TripPoint {
  id        String   @id @default(cuid())
  tripId    String
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  at        DateTime
  lat       Float
  lng       Float
  accuracyM Float?

  @@index([tripId, at])
  @@map("trip_points")
}

// ---------------------------------------------------------------------------
// The value ledger
//
// A product that claims to save money has to show its own arithmetic. Every
// line here is append-only and dated: what an officer found, what the owner
// accepted, what could later be verified in the data, and what the platform
// charged. Nothing is edited; a wrong line is answered by another line.
// ---------------------------------------------------------------------------

model ValueEntry {
  id       String    @id @default(cuid())
  tenantId String
  // Written as a side effect of raising and deciding, never on request — so
  // it goes with its workspace rather than holding one open.
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  officer  Officer
  kind     ValueKind
  /// Whole cents, stored wide for the same reason as Observation.moneyCents.
  cents    Float
  at       DateTime  @default(now())

  observationId String?
  // How a REALISED figure was verified, in words a person can check.
  method        String?
  note          String?

  @@index([tenantId, at])
  @@index([tenantId, observationId, kind])
  @@map("value_entries")
}

// Expected vs counted stock, per count — the retail shrinkage-variance
// research finding, made visible instead of only discovered months later.
model Stocktake {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  expectedQty Int
  countedQty  Int
  countedById String // Membership.id
  createdAt   DateTime @default(now())

  @@index([tenantId, itemId])
  @@map("stocktakes")
}

enum ClaimStatus {
  SUBMITTED
  PAID
  DENIED
  REWORKED
}

// Structured insurance-claim tracking — not a real payer/insurance API
// integration, just the difference between "a denied claim quietly aged
// into a write-off" (the research finding) and one that's visibly tracked
// until it's resolved.
model InsuranceClaim {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  transactionId String // the invoice this claim is for
  payerName     String
  claimedCents  Int
  status        ClaimStatus @default(SUBMITTED)
  denialReason  String?
  submittedAt   DateTime    @default(now())
  resolvedAt    DateTime?

  @@index([tenantId, status])
  @@map("insurance_claims")
}

// ---------------------------------------------------------------------
// POS — own built-in checkout plus region-scaffolded card-provider
// integrations (RSA/Yoco first). A TillSession brackets a cash-drawer
// session (open float -> sales -> close/count), same reconciliation
// philosophy as Stocktake: expected vs counted, variance surfaced instead
// of silently absorbed.
// ---------------------------------------------------------------------

model TillSession {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  openedById          String // Membership.id
  openingFloatCents   Int
  openedAt            DateTime  @default(now())
  closedById          String?
  closingCountedCents Int?
  // Persisted at close time so the mismatch flag survives past the single
  // request that closed the till — see closeTill() in src/lib/core/pos.ts.
  // Positive = counted more cash than expected, negative = a shortfall.
  varianceCents       Int?
  closedAt            DateTime?

  payments Transaction[]

  @@index([tenantId])
  @@map("till_sessions")
}

enum PosProviderType {
  YOCO
  IKHOKHA
  SQUARE
  ZELLER
  GENERIC
}

// Scaffolded per-region so adding a new market is one new provider file,
// not a schema change — region is stored alongside provider so the
// settings UI can filter the picker to what's relevant for that tenant.
model PosIntegration {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  provider  PosProviderType
  region    String // "RSA" | "USA" | "AU" | "EU"
  apiKey    String? // opaque; stubbed (logs instead of charging) until set
  isActive  Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("pos_integrations")
}

// Online card payments — lets a CUSTOMER pay a quote/invoice from the
// portal by card, distinct from PosIntegration (which is the merchant's
// own in-person till). One tenant can enable several; whichever is
// isActive and matches the tenant's region is offered on the portal.
enum PaymentGatewayProvider {
  // RSA
  YOCO
  PAYFAST
  PEACH_PAYMENTS
  OZOW
  IKHOKHA
  SNAPSCAN
  PAYSTACK
  NETCASH
  // USA
  STRIPE
  PAYPAL
  SQUARE
  AUTHORIZE_NET
  BRAINTREE
}

model PaymentGateway {
  id            String                 @id @default(cuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  provider      PaymentGatewayProvider
  region        String // "RSA" | "USA"
  publicKey     String? // safe to expose client-side (Stripe publishable key, PayFast merchant id, etc.)
  secretKey     String? // opaque; stubbed (returns a fake success) until set
  // Signing secret for the provider's server-to-server callback: Stripe's
  // whsec_..., PayFast's passphrase, Paystack/Yoco's webhook secret. A
  // payment is only written to the ledger when a callback signed with this
  // verifies — a customer landing back on the return URL proves nothing.
  webhookSecret String?
  isActive      Boolean                @default(false)
  createdAt     DateTime               @default(now())

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("payment_gateways")
}

// A customer-initiated card payment attempt, tracked separately from the
// Transaction ledger until the gateway confirms it — only a confirmed
// checkout is allowed to call recordPayment and write a real PAYMENT row,
// so a customer closing the tab mid-checkout never corrupts the ledger.
model PaymentCheckout {
  id             String                 @id @default(cuid())
  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  invoiceId      String
  invoice        Transaction            @relation(fields: [invoiceId], references: [id])
  provider       PaymentGatewayProvider
  amountCents    Int
  reference      String? // gateway's checkout/session id
  status         String                 @default("PENDING") // PENDING | CONFIRMED | FAILED
  createdAt      DateTime               @default(now())
  confirmedAt    DateTime?
  // Set when a verified webhook confirmed this checkout, and by which
  // provider event. Null on a CONFIRMED row means it was confirmed some
  // other way, which should never happen now and is worth auditing.
  webhookEventId String?                @unique
  failureReason  String?

  @@index([tenantId])
  @@index([invoiceId])
  @@index([reference])
  @@map("payment_checkouts")
}

// Storefront sync — WordPress/WooCommerce today, scaffolded per platform
// like PosIntegration/PaymentGateway so Shopify/BigCommerce are one new
// enum value + one new client file later, not a schema change.
enum EcommercePlatform {
  WOOCOMMERCE
}

model EcommerceIntegration {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  platform          EcommercePlatform
  storeUrl          String // e.g. https://shop.example.com
  consumerKey       String? // WooCommerce REST API key (ck_...)
  consumerSecretEnc String? // AES-256-GCM encrypted (WooCommerce cs_... secret)
  webhookSecretEnc  String? // AES-256-GCM encrypted — verifies WooCommerce's X-WC-Webhook-Signature
  isActive          Boolean           @default(false)
  lastProductSyncAt DateTime?
  createdAt         DateTime          @default(now())

  orders EcommerceOrder[]

  @@unique([tenantId, platform])
  @@index([tenantId])
  @@map("ecommerce_integrations")
}

// One row per external order already turned into a flow invoice — the
// idempotency guard so a WooCommerce webhook retry (it retries on
// anything but a 200) never creates a duplicate invoice for the same order.
model EcommerceOrder {
  id              String               @id @default(cuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  integrationId   String
  integration     EcommerceIntegration @relation(fields: [integrationId], references: [id])
  externalOrderId String // WooCommerce order id, as a string
  invoiceId       String?              @unique
  invoice         Transaction?         @relation(fields: [invoiceId], references: [id])
  createdAt       DateTime             @default(now())

  @@unique([integrationId, externalOrderId])
  @@index([tenantId])
  @@map("ecommerce_orders")
}

// ---------------------------------------------------------------------
// Non-profit / faith organization niche — membership, donations, and
// compliance-filing history, built append-only so "prove I was involved,
// from when to when" is always answerable later (the real gap that
// prompted this module: churches/NPOs losing exactly this kind of record).
// ---------------------------------------------------------------------

enum InvolvementRole {
  MEMBER
  VOLUNTEER
  BOARD
  STAFF
  SPONSOR
}

// A person's involvement is tracked as a history of roles over time rather
// than a single current status — closing (setting endDate) never deletes
// the row, so a past involvement is provable years later.
model MembershipInvolvement {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  partyId      String
  party        Party           @relation(fields: [partyId], references: [id])
  role         InvolvementRole
  startDate    DateTime
  endDate      DateTime?
  // When set, this membership/sponsorship is due for renewal on this date
  // — the PA job "chase a lapsing membership the same way a quote gets
  // chased" (src/lib/core/nonprofit.ts checkMembershipRenewals) reads
  // this instead of assuming an annual cadence, since renewal terms
  // genuinely vary member to member.
  renewalDueAt DateTime?
  notes        String?
  createdAt    DateTime        @default(now())

  @@index([tenantId, partyId])
  @@map("membership_involvements")
}

// A real ledger, kept separate from the commercial Transaction model —
// a donation isn't a sale (no line items, no VAT), it's a gift toward a
// designated fund/purpose, and needs its own receipt/certificate trail.
model Donation {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  partyId        String
  party          Party    @relation(fields: [partyId], references: [id])
  amountCents    Int
  designatedFund String? // e.g. "Building Fund", "General", null = unrestricted
  receiptNumber  String?
  donatedAt      DateTime @default(now())

  @@index([tenantId, donatedAt])
  @@map("donations")
}

// Structured record of the exact kind of document whose absence caused
// the user's real problem — annual returns, PBO/tax-exempt filings, AGM
// minutes. documentDataUrl reuses the same base64 attachment pattern as
// e-signatures/photos elsewhere, no object storage dependency.
model ComplianceFiling {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  filingType      String // "Annual Return" | "PBO Renewal" | "AGM Minutes" | ...
  filingDate      DateTime
  documentDataUrl String?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([tenantId, filingType])
  @@map("compliance_filings")
}

// ---------------------------------------------------------------------
// Obligations — the dated things this business owes somebody else, and
// what it costs to miss them.
//
// One engine rather than seven registers. A CIPC annual return, a liquor
// licence, a driver's PDP, an insurance policy, the notice window on a
// supplier contract and a warranty on something we sold are all the same
// shape: something falls due on a date, some of them repeat, each has a
// consequence, and a few of them should physically stop work happening
// when they lapse. Modelled once, the agent watches all of them with one
// piece of logic and a new category is a row instead of a table.
//
// Distinct from ComplianceFiling above, deliberately: that records what
// was filed, this records what is owed. Completing an obligation of kind
// COMPLIANCE_FILING writes a ComplianceFiling row, so the log keeps
// working exactly as it did.
// ---------------------------------------------------------------------

enum ObligationKind {
  COMPLIANCE_FILING // CIPC annual return, COIDA return, AGM minutes
  LICENCE // trading, liquor, health, professional body registration
  CERTIFICATE // tax clearance, BEE affidavit, letter of good standing
  TAX // VAT201, EMP201, IRP6
  INSURANCE // policy renewal
  CONTRACT // customer or supplier agreement with a notice window
  WARRANTY // what we sold, and how long it stays our problem
  DOCUMENT // a person's or an asset's document: PDP, work permit, roadworthy
}

enum ObligationRecurrence {
  NONE
  MONTHLY
  BIMONTHLY // SARS VAT201 for most small vendors
  QUARTERLY
  BIANNUAL // IRP6 provisional tax
  ANNUAL
}

// How bad it is to miss this. Drives ordering, how early the agent starts
// warning, and whether it is allowed to stay quiet about it.
enum ObligationSeverity {
  CRITICAL // the company stops existing, or stops being allowed to trade
  HIGH // locked out of tenders, sites or customers
  MEDIUM // penalty, interest or a fine
  LOW // administrative tidiness
}

enum ObligationStatus {
  OPEN
  DONE
  WAIVED // consciously decided not to do — kept, not deleted, so "why isn't this on the list" stays answerable
}

model Obligation {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  kind        ObligationKind
  title       String
  authority   String? // who wants it: CIPC, SARS, the Department of Employment and Labour, an insurer, a supplier
  reference   String? // registration, policy or certificate number
  dueAt       DateTime
  recurrence  ObligationRecurrence @default(NONE)
  severity    ObligationSeverity   @default(MEDIUM)
  status      ObligationStatus     @default(OPEN)
  // How many days before dueAt this stops being background and becomes
  // work. Seeded per kind — a CIPC return needs a month of warning, a
  // vehicle licence disc needs a week.
  leadDays    Int                  @default(30)
  // Plain sentence naming what actually happens if this lapses. Stored
  // rather than derived because it is the single most useful thing on the
  // record and it differs per business — the agent quotes it verbatim
  // instead of inventing a reason the thing matters.
  consequence String?

  // Contract-specific. noticeDays is the window before dueAt in which
  // notice has to be given, which is the date that actually matters on an
  // auto-renewing agreement — miss it and you have renewed by silence.
  noticeDays Int?
  autoRenews Boolean @default(false)

  // When true, this lapsing is not advice. Work that depends on the
  // subject is refused rather than warned about — an expired PDP means
  // that driver does not get dispatched.
  blocksWork Boolean @default(false)

  // The library row this came from, when it came from one. Lets a correction
  // made here be offered back to the library, and lets us stop suggesting a
  // template this business has already dismissed.
  templateId String?

  // What the obligation is about, when it is about something. All
  // optional and all real foreign keys rather than a loose type/id pair,
  // so "show me everything expiring on this vehicle" is a query and not a
  // string comparison.
  partyId       String?
  party         Party?       @relation(fields: [partyId], references: [id])
  membershipId  String?
  membership    Membership?  @relation(fields: [membershipId], references: [id])
  itemId        String?
  item          Item?        @relation(fields: [itemId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  // The vehicle or machine this is about: its licence disc, its insurance,
  // its roadworthy. Lets "everything on this truck" be a query, and lets the
  // insurance book be read per vehicle.
  assetId       String?
  asset         Asset?       @relation(fields: [assetId], references: [id])

  // What it costs each time it falls due — the premium, the licence fee. Per
  // recurrence period. Null when nobody has said; the watch then ranks it by
  // severity alone rather than inventing a figure.
  amountCents Int?

  completedAt       DateTime?
  documentDataUrl   String? // proof, same base64 pattern as e-signatures and receipts
  notes             String?
  // What the owner was last told about this, and when. The compliance watch
  // runs on every tick, so without this it would re-raise the same lapsed
  // licence every fifteen minutes and be muted within a day. Notifications
  // fire on a change of state, not on the state itself.
  lastNotifiedState String?
  lastNotifiedAt    DateTime?

  // Set when this row was created by advancing a recurring obligation,
  // so a history of "we have done this every year" is reconstructable.
  previousId String?
  createdAt  DateTime @default(now())

  @@index([tenantId, status, dueAt])
  @@index([tenantId, kind])
  @@index([tenantId, blocksWork, status])
  @@map("obligations")
}

// ---------------------------------------------------------------------
// The books.
//
// Until now this app had a sales ledger — quotes, invoices, payments — and
// called it money. That tells you what you invoiced and what you spent, which
// is not the same as knowing whether you made anything, and it cannot be
// reconciled against a bank statement or handed to an accountant.
//
// Two invariants carry the whole design, and both exist to make the agent
// safe rather than to satisfy bookkeeping convention:
//
//   BALANCE. An entry whose debits and credits differ cannot be written. The
//   check lives in the code that creates entries, so no caller — a person, a
//   server action or an agent tool — has a path around it. An agent that
//   posts something wrong produces a wrong-but-balanced book, which is
//   correctable; one that could post something unbalanced produces a book
//   nobody can trust again.
//
//   IRREVERSIBILITY. A posted entry is never edited or deleted. A mistake is
//   corrected by a reversing entry that points back at it, so the history of
//   what was believed and when survives. This is what makes "the agent did
//   this" auditable rather than a claim.
// ---------------------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  // Numeric code by convention: 1xxx asset, 2xxx liability, 3xxx equity,
  // 4xxx income, 5xxx expense. Kept as a string because real charts use
  // things like "1000.10" once a business grows a second branch.
  code     String
  name     String
  type     AccountType
  // Free text, because the useful subdivisions differ by trade and an enum
  // here would be the same mistake as hardcoding a country's tax filings.
  subtype  String?
  isActive Boolean     @default(true)
  // Accounts the system posts to automatically. Protected from deletion,
  // because losing the one that invoices post to breaks every future
  // invoice rather than just this screen.
  isSystem Boolean     @default(false)
  parentId String?
  parent   Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]   @relation("AccountTree")

  lines     JournalLine[]
  createdAt DateTime      @default(now())

  bankAccounts        BankAccount[]
  reconciliationRules ReconciliationRule[]
  expenses            Expense[]

  @@unique([tenantId, code])
  @@index([tenantId, type])
  @@map("accounts")
}

// Where an entry came from. A journal full of rows nobody can trace back to
// a document is a journal nobody trusts.
enum JournalSource {
  INVOICE
  PAYMENT
  REFUND
  EXPENSE
  OPENING_BALANCE
  MANUAL
  REVERSAL
}

model JournalEntry {
  id         String        @id @default(cuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  // The date the event happened, which is not the date it was captured —
  // a January invoice entered in March belongs in January.
  entryDate  DateTime
  memo       String?
  source     JournalSource @default(MANUAL)
  // The document this came from, when it came from one. Deliberately a bare
  // id plus a type rather than four nullable foreign keys: the journal
  // should not gain a column every time something new becomes postable.
  sourceType String?
  sourceId   String?

  lines JournalLine[]

  // Set when this entry undoes another. Corrections are new entries, never
  // edits, so both the mistake and the fix stay visible.
  reversesId String?       @unique
  reverses   JournalEntry? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy JournalEntry? @relation("Reversal")

  createdById String?
  // True when an agent posted this rather than a person. Every automated
  // posting is identifiable without reading the memo.
  byAgent     Boolean  @default(false)
  createdAt   DateTime @default(now())

  bankLines BankTransaction[]

  // Carried onto the ledger so a profit and loss can be filtered by branch.
  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([tenantId, entryDate])
  @@index([tenantId, sourceType, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id          String       @id @default(cuid())
  entryId     String
  entry       JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId   String
  account     Account      @relation(fields: [accountId], references: [id])
  // Exactly one of these is non-zero on any given line. Two columns rather
  // than one signed amount because every accountant, export and report in
  // the world expects debit and credit as separate quantities.
  debitCents  Int          @default(0)
  creditCents Int          @default(0)
  memo        String?

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

// A month that has been closed. Nothing may be posted into it afterwards —
// not by a person and not by the agent. This is the invariant that makes
// raising the agent's autonomy a setting rather than an act of courage.
model AccountingPeriod {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  year     Int
  month    Int
  closedAt DateTime @default(now())
  closedBy String?
  note     String?

  @@unique([tenantId, year, month])
  @@index([tenantId])
  @@map("accounting_periods")
}

// ---------------------------------------------------------------------
// The coordination layer.
//
// Six officers each entitled to interrupt is six sources of noise, and an
// owner mutes all of them within a fortnight. So officers do not notify.
// They write observations here — durable, typed, evidenced — and exactly one
// coordinator decides what reaches a person today.
//
// An observation is deliberately not a message. A message can only be sent or
// not sent; an observation can be deduplicated against others, ranked against
// them, held back today and raised next week when it has got worse. That
// difference is the entire reason this table exists rather than a notification
// call at each site.
// ---------------------------------------------------------------------

enum Officer {
  CEO
  CFO
  COO
  LEGAL
  SALES
  EFFICIENCY
  /// Deterministic watchers with no model behind them — the compliance watch,
  /// the forecast. They observe on the same bus so the coordinator ranks them
  /// against everything else rather than them having a private channel.
  SYSTEM
}

enum ObservationStatus {
  OPEN // written, never yet shown
  RAISED // put in front of a person
  ACTIONED // acted on
  DISMISSED // explicitly rejected — must never be raised again
  SUPERSEDED // a newer observation about the same thing replaced it
  EXPIRED // went stale before it was ever worth raising
}

model Observation {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  officer  Officer

  /// One sentence, quotable verbatim. This is what a person actually reads.
  headline String
  detail   String?

  /// What it is worth, in cents. The primary ranking signal — an assistant
  /// that cannot rank by money ends up ranking by recency, which is how
  /// trivia crowds out the thing that mattered.
  ///
  /// Whole cents, stored wide: a finding about a year of invoices can pass
  /// R21.4 million, the most a 32-bit integer holds. A double is exact for
  /// whole numbers far beyond any business this serves; writers round.
  moneyCents Float?
  /// 0-100. Low confidence does not mean do not raise; it means say so.
  confidence Int       @default(50)
  /// After this, acting is pointless rather than merely late.
  urgentBy   DateTime?

  /// Same subject and same kind means the same conversation. Three officers
  /// noticing one struggling customer should reach a person once.
  dedupeKey String

  subjectType String?
  subjectId   String?

  /// The facts that led here, so a person can check rather than trust.
  /// Shape: [{ label, value, href? }]
  evidence Json?

  /// What to do about it, in the officer's own words.
  proposedAction String?

  /// Set when one officer handed this to another; the observation stays one
  /// item and carries both.
  handedTo Officer?

  status       ObservationStatus @default(OPEN)
  raisedAt     DateTime?
  decidedAt    DateTime?
  decidedById  String?
  /// Why it was dismissed. Read back to the officer so it stops suggesting it.
  decisionNote String?

  supersedesId String?
  createdAt    DateTime @default(now())

  @@index([tenantId, status, createdAt])
  @@index([tenantId, dedupeKey])
  @@map("observations")
}

/// What each officer is allowed to do on its own, per workspace.
///
/// Separate from the workspace-wide AgentAutonomy because the whole point of
/// six officers is that they differ: a COO rescheduling a job is not a CFO
/// posting a journal entry, and one setting for both forces the cautious
/// answer on everything.
model OfficerAutonomy {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  officer   Officer
  /// Highest rung this officer may reach unaided. See agent/ladder.ts.
  ceiling   String   @default("SUGGEST")
  updatedAt DateTime @updatedAt

  @@unique([tenantId, officer])
  @@map("officer_autonomy")
}

// ---------------------------------------------------------------------
// Branches.
//
// A dimension, not a hierarchy. The question a multi-site business cannot
// answer is "which branch actually makes money", and averaging them together
// is how a profitable one carries a loss-making one for years unnoticed.
//
// Deliberately optional everywhere. A single-site business should never see
// a branch field, and every row with a null branch stays perfectly valid —
// which is also what makes this safe to add to a system already full of data.
// ---------------------------------------------------------------------

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  code      String? // short label for documents and reports
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  transactions   Transaction[]
  expenses       Expense[]
  memberships    Membership[]
  assets         Asset[]
  journalEntries JournalEntry[]
  trips          Trip[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("branches")
}

// ---------------------------------------------------------------------
// Progress billing and retention.
//
// Trades and construction do not invoice once at the end. They agree a total,
// bill a percentage as work completes, and the customer holds back a slice —
// the retention — until a defects period expires months later. No small
// business tool models this, so operators run it on a spreadsheet and lose
// track of the retention, which is pure profit sitting uncollected.
//
// Two ideas carry it:
//
//   CLAIMS ARE CUMULATIVE. A claim states the percentage of the whole job
//   complete to date, not the slice since last time. That is how the industry
//   works and how disputes are settled, and deriving the slice from it is
//   arithmetic we can do rather than a subtraction somebody gets wrong.
//
//   RETENTION IS AN OBLIGATION. Money held back is money owed on a future
//   date, which is exactly what the obligation engine already chases. So
//   releasing it becomes a dated thing with a consequence rather than a
//   number in a column nobody revisits.
// ---------------------------------------------------------------------

enum AgreementStatus {
  ACTIVE
  COMPLETE // all work claimed; retention may still be outstanding
  SETTLED // retention released too — genuinely finished
  CANCELLED
}

model ProgressAgreement {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  partyId  String
  party    Party  @relation(fields: [partyId], references: [id])

  title            String
  totalValueCents  Int
  /**
   * Percentage of every claim the customer withholds, typically 5 or 10.
   */
  retentionPercent Float     @default(0)
  /**
   * When the defects period ends and retention becomes payable.
   */
  retentionDueAt   DateTime?

  status    AgreementStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime        @default(now())

  claims ProgressClaim[]

  @@index([tenantId, status])
  @@map("progress_agreements")
}

model ProgressClaim {
  id          String            @id @default(cuid())
  tenantId    String
  agreementId String
  agreement   ProgressAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  /**
   * Claim 1, 2, 3 — the number the customer and the QS both refer to.
   */
  sequence        Int
  /**
   * Cumulative completion this claim asserts, 0-100.
   */
  percentComplete Float
  /**
   * This claim's own value, derived from the cumulative percentage.
   */
  grossCents      Int
  /**
   * Withheld from this claim.
   */
  retentionCents  Int
  /**
   * Actually invoiced now: gross less retention.
   */
  netCents        Int

  /**
   * The invoice raised for the net. Null until it is issued.
   */
  invoiceId String?
  claimedAt DateTime @default(now())

  @@unique([agreementId, sequence])
  @@index([tenantId])
  @@map("progress_claims")
}

// ---------------------------------------------------------------------
// The things and people a business is responsible for.
//
// Assets, leave, employment records and handovers are four features in most
// products. Here they lean on one another: an asset is issued to a person, a
// person's documents expire and can stop work through the obligation engine,
// and what they hold and know is what a handover is made of. Modelling them
// apart would mean the day somebody leaves is still four screens and a
// forgotten laptop.
// ---------------------------------------------------------------------

enum AssetStatus {
  IN_STOCK // held by the business, not issued
  ISSUED // out with a person
  IN_REPAIR
  LOST
  RETIRED // sold, scrapped or written off — kept, never deleted
}

model Asset {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  name     String
  category String? // "laptop", "vehicle", "power tool" — free text, because every trade's list differs
  serial   String?
  status   AssetStatus @default(IN_STOCK)

  // What it cost and when, so depreciation (phase 120) has something real to
  // work from rather than asking somebody to type their asset register twice.
  purchasedOn      DateTime?
  purchaseCents    Int?
  // Expected life in months. Null means nobody has said, which is different
  // from zero and must not be depreciated as if it were.
  usefulLifeMonths Int?

  /**
   * Who has it now. Null when it is in stock, in repair or gone.
   */
  holderId String?
  holder   Membership? @relation("AssetHolder", fields: [holderId], references: [id])
  issuedAt DateTime?

  notes     String?
  createdAt DateTime @default(now())

  movements AssetMovement[]

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  // What one unit of this asset's capacity is. Null means nobody has said and
  // no "cost per" figure is produced for it — a made-up denominator is worse
  // than none.
  capacityUnit CapacityUnit?
  // Number plate, serial on the side of the machine — whatever a slip, a
  // licence disc or an insurance schedule will name it by.
  registration String?
  // Maintenance off the odometer: service every N km, last done at reading M.
  serviceIntervalKm Int?
  lastServiceKm     Int?
  // Load planning: what it weighs empty and what it may weigh loaded.
  tareKg       Int?
  maxGrossKg   Int?
  incidents    Incident[]

  expenses    Expense[]
  trips       Trip[]
  obligations Obligation[]
  fuelLogs    FuelLog[]

  @@index([tenantId, status])
  @@index([tenantId, holderId])
  @@map("assets")
}

// Every issue, return and write-off. Append-only: "who had the drill in March"
// is a question somebody asks in June, and a current-holder field alone
// cannot answer it.
model AssetMovement {
  id       String   @id @default(cuid())
  assetId  String
  asset    Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenantId String
  fromId   String? // Membership.id, null when coming out of stock
  toId     String? // Membership.id, null when going back to stock or out of service
  kind     String // "issued" | "returned" | "repair" | "lost" | "retired"
  note     String?
  at       DateTime @default(now())

  @@index([tenantId, at])
  @@index([assetId])
  @@map("asset_movements")
}

enum LeaveKind {
  ANNUAL
  SICK
  FAMILY // family responsibility
  UNPAID
  PARENTAL
  OTHER
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  DECLINED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id])
  membershipId String
  membership   Membership  @relation("LeaveTaker", fields: [membershipId], references: [id])
  kind         LeaveKind   @default(ANNUAL)
  startOn      DateTime
  endOn        DateTime
  // Working days, computed when the request is made and stored — a later
  // change to the public-holiday list must not silently restate leave that
  // has already been approved and taken.
  days         Float
  status       LeaveStatus @default(REQUESTED)
  reason       String?
  decidedById  String?
  decidedAt    DateTime?
  createdAt    DateTime    @default(now())

  @@index([tenantId, status])
  @@index([membershipId, startOn])
  @@map("leave_requests")
}

// A day nobody is expected to work. Seeded per country from the obligation
// library's jurisdiction, and editable — every business has days of its own.
model Holiday {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  onDate    DateTime
  createdAt DateTime @default(now())

  @@unique([tenantId, onDate, name])
  @@index([tenantId, onDate])
  @@map("holidays")
}

enum EmploymentRecordKind {
  CONTRACT
  WARNING
  REVIEW
  QUALIFICATION
  ONBOARDING
  OFFBOARDING
  NOTE
}

// The file you need on the day it goes wrong.
//
// Append-only by design: a warning that can be edited after the fact is not
// evidence of anything, and the whole point of keeping these is that they
// hold up later.
model EmploymentRecord {
  id              String               @id @default(cuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  membershipId    String
  membership      Membership           @relation("EmploymentSubject", fields: [membershipId], references: [id])
  kind            EmploymentRecordKind
  title           String
  body            String?
  documentDataUrl String? // same base64 pattern as e-signatures and receipts
  effectiveOn     DateTime
  recordedById    String?
  createdAt       DateTime             @default(now())

  @@index([tenantId, membershipId])
  @@map("employment_records")
}

// ---------------------------------------------------------------------
// Bank accounts, statement lines, and the matching between them.
//
// Reconciliation is the most-loved feature in this category and the one
// place an agent genuinely does the job better than a person — not because
// it is cleverer, but because it is willing to consider four hundred
// candidate matches for one statement line and a person is not.
//
// The design point: a proposed match is never applied on its own. Each one
// carries a confidence and a stated reason, the owner approves a screenful
// at a time, and what they overrule becomes a rule. An agent that silently
// reconciled would be faster and completely untrustworthy; the value is in
// doing the looking, not in taking the decision.
// ---------------------------------------------------------------------

model BankAccount {
  id                        String    @id @default(cuid())
  tenantId                  String
  tenant                    Tenant    @relation(fields: [tenantId], references: [id])
  name                      String
  // Last four digits only. There is no reason this app needs the rest, and
  // every reason not to hold it.
  last4                     String?
  // The ledger account this bank account posts through. Without the link a
  // reconciled statement would balance against nothing.
  accountId                 String
  account                   Account   @relation(fields: [accountId], references: [id])
  currency                  String    @default("ZAR")
  isActive                  Boolean   @default(true)
  // What the statement said the balance was at the last import, so a
  // divergence between the bank and the books is visible rather than
  // inferred.
  lastStatementBalanceCents Int?
  lastStatementAt           DateTime?

  // ---- the feed ------------------------------------------------------
  //
  // A feed is the same statement arriving by itself instead of being
  // downloaded and uploaded. Everything downstream — matching, the rules,
  // the books — is identical, which is the point: the importer stays the
  // one path, and a feed is just what calls it.
  //
  // A provider key from bankFeeds.ts, or null for an account somebody
  // imports by hand. Credentials are encrypted at rest and, like every
  // other secret in this app, are excluded from the export.
  feedProvider     String?
  feedRef          String?
  feedSecretEnc    String?
  feedConnectedAt  DateTime?
  feedLastSyncAt   DateTime?
  /// Set when a sync fails, cleared when one works. A feed that quietly
  /// stopped is worse than one that never started.
  feedError        String?
  /// Auto-accept matches at or above this confidence. Null means never —
  /// the deliberate default, because a wrong entry posted automatically is
  /// found weeks later by somebody who did not make it.
  autoMatchAtOrAbove Int?

  createdAt                 DateTime  @default(now())

  transactions BankTransaction[]

  @@index([tenantId])
  @@map("bank_accounts")
}

enum BankLineStatus {
  UNMATCHED
  MATCHED
  // Deliberately set aside — an internal transfer, a duplicate the bank
  // reversed. Kept rather than deleted so it does not reappear on the next
  // import looking new.
  IGNORED
}

model BankTransaction {
  id             String         @id @default(cuid())
  bankAccountId  String
  bankAccount    BankAccount    @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  tenantId       String
  postedOn       DateTime
  description    String
  reference      String?
  // Signed the way a statement reads: positive is money in, negative is
  // money out. Storing it unsigned with a separate direction flag reads
  // worse at every call site and invites the sign to be lost.
  amountCents    Int
  balanceCents   Int?
  // Stable identity for a line, so re-importing an overlapping statement
  // does not duplicate it. Either the bank's own id or a hash of the line.
  fingerprint    String
  status         BankLineStatus @default(UNMATCHED)
  // What this line was matched to, once approved.
  matchedEntryId String?
  matchedEntry   JournalEntry?  @relation(fields: [matchedEntryId], references: [id])
  matchedAt      DateTime?
  matchedByAgent Boolean        @default(false)
  note           String?
  importedAt     DateTime       @default(now())

  @@unique([bankAccountId, fingerprint])
  @@index([tenantId, status])
  @@index([bankAccountId, postedOn])
  @@map("bank_transactions")
}

// What the business taught us by correcting a match.
//
// The whole reason an agent improves at this rather than being equally
// wrong every month: "anything from SASOL is vehicle and fuel" is learned
// once from a correction and applied forever after.
model ReconciliationRule {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  // Case-insensitive substring of the statement description.
  matchText      String
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id])
  // How many times this rule has been applied without being overruled. A
  // rule that keeps getting corrected should stop being trusted.
  timesApplied   Int      @default(0)
  timesOverruled Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([tenantId, matchText])
  @@index([tenantId])
  @@map("reconciliation_rules")
}

// ---------------------------------------------------------------------
// The obligation library — shared across every workspace, owned by none.
//
// This is the part that stops compliance being a South African feature. No
// obligation title, authority or deadline is written in code: they are rows
// here, keyed by country and region. A workspace in Ohio and a workspace in
// Gauteng run the identical code path and get entirely different calendars,
// because the difference lives in data.
//
// Rows arrive three ways, and all three matter:
//
//   CURATED  - seeded for the markets we already serve.
//   DOCUMENT - extracted from a document a real business uploaded. Their
//              licence tells us what that licence is called in their country
//              far more reliably than any list we could write.
//   RESEARCH - the model filling in a jurisdiction nobody has covered yet,
//              the first time a business from there signs up.
//
// The counters are the quality signal. A template many businesses kept is
// more trustworthy than one everybody dismissed, and that ordering is what
// keeps a bad guess from propagating to the next user from that country.
// ---------------------------------------------------------------------

enum ObligationTemplateSource {
  CURATED
  DOCUMENT // learned from a document a business uploaded
  RESEARCH // researched for a jurisdiction on first use
  USER // typed in by a business, offered onward
}

model ObligationTemplate {
  id          String                   @id @default(cuid())
  countryCode String // ISO 3166-1 alpha-2
  regionCode  String? // null = applies across the whole country
  title       String
  authority   String?
  kind        ObligationKind
  recurrence  ObligationRecurrence     @default(ANNUAL)
  severity    ObligationSeverity       @default(MEDIUM)
  leadDays    Int                      @default(30)
  consequence String?
  noticeDays  Int?
  blocksWork  Boolean                  @default(false)
  source      ObligationTemplateSource @default(RESEARCH)

  // When in the year it usually falls. Null where it depends on the
  // business's own dates (an incorporation anniversary, a policy renewal)
  // rather than on a fixed national deadline.
  dueMonth                    Int?
  dueDay                      Int?
  // Set when the date follows the business's own registration anniversary
  // rather than a fixed calendar date.
  fromRegistrationAnniversary Boolean @default(false)

  // Which businesses this applies to. Null means "does not depend on it",
  // which is different from false — an obligation that applies whether or
  // not you employ people must not be filtered out of an employer's list.
  requiresCompany   Boolean?
  requiresVat       Boolean?
  requiresEmployees Boolean?
  requiresVehicles  Boolean?

  // Trust signals, not analytics: these order what gets offered first and
  // retire templates nobody accepts.
  adoptedCount   Int @default(0)
  confirmedCount Int @default(0)
  dismissedCount Int @default(0)

  // Provenance for our own debugging. Never shown to another workspace —
  // a business's compliance profile is not something to leak sideways.
  contributedByTenantId String?
  sourceNote            String?
  createdAt             DateTime @default(now())

  @@unique([countryCode, regionCode, title])
  @@index([countryCode, regionCode])
  @@map("obligation_templates")
}

// Records that a jurisdiction has been looked at, so the research pass runs
// once per country rather than once per signup — and so a country with
// genuinely nothing found is not re-researched on every visit.
model JurisdictionCoverage {
  id            String    @id @default(cuid())
  countryCode   String
  regionCode    String?
  templateCount Int       @default(0)
  researchedAt  DateTime?
  /**
   * Why coverage is thin, when it is. Shown to the user rather than hidden.
   */
  note          String?
  updatedAt     DateTime  @updatedAt

  @@unique([countryCode, regionCode])
  @@map("jurisdiction_coverage")
}

// ---------------------------------------------------------------------
// Rentals — platform-wide, not tied to one niche. Any Item can be marked
// rentable instead of (or as well as) sellable; a Rental tracks the
// out/returned lifecycle a straight sale doesn't need.
// ---------------------------------------------------------------------

enum RentalRateUnit {
  HOUR
  DAY
  WEEK
  MONTH
}

enum RentalStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

model Rental {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  itemId        String
  item          Item           @relation(fields: [itemId], references: [id])
  partyId       String
  party         Party          @relation(fields: [partyId], references: [id])
  startAt       DateTime       @default(now())
  endAt         DateTime? // expected return — null = open-ended
  returnedAt    DateTime?
  rateCents     Int
  rateUnit      RentalRateUnit
  depositCents  Int?
  status        RentalStatus   @default(ACTIVE)
  transactionId String? // the invoice covering this rental, once billed

  @@index([tenantId, status])
  @@map("rentals")
}

// ---------------------------------------------------------------------
// Property sales, leasing & management — its own domain: a Property is
// the asset, a Lease is a specific tenancy on it. Reuses Event (with a
// new PROPERTY_INSPECTION type) for inspections/maintenance visits rather
// than a parallel model, consistent with how Event already generalizes
// site visits/deliveries/installs.
// ---------------------------------------------------------------------

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  LAND
}

enum PropertyStatus {
  AVAILABLE
  LEASED
  SOLD
  MAINTENANCE
}

model Property {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  address           String
  propertyType      PropertyType
  ownerPartyId      String? // set when managing on behalf of an owner, not the agency's own stock
  status            PropertyStatus @default(AVAILABLE)
  listingPriceCents Int? // for sale
  rentalRateCents   Int? // for lease, per month
  createdAt         DateTime       @default(now())

  leases Lease[]

  @@index([tenantId, status])
  @@map("properties")
}

enum LeaseStatus {
  ACTIVE
  ENDED
  TERMINATED
}

model Lease {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  propertyId       String
  property         Property    @relation(fields: [propertyId], references: [id])
  renterPartyId    String
  renterParty      Party       @relation(fields: [renterPartyId], references: [id])
  startDate        DateTime
  endDate          DateTime?
  monthlyRentCents Int
  depositCents     Int?
  status           LeaseStatus @default(ACTIVE)
  documentDataUrl  String? // the signed lease contract
  createdAt        DateTime    @default(now())

  @@index([tenantId, status])
  @@index([propertyId])
  @@map("leases")
}

// ---------------------------------------------------------------------
// PDF templates — styleKey references a fixed design config in
// src/lib/pdf/styles.ts, not a DB-editable layout (so "10+ templates"
// means 10 real, tested layouts, not a page-builder). A tenant can own
// several of these (recommended: one default + up to 2 customized), pick
// which style each is based on, and override its accent color/logo.
// ---------------------------------------------------------------------

model TenantPdfTemplate {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  name             String
  styleKey         String // one of the keys in PDF_STYLES
  isDefault        Boolean  @default(false)
  accentColorHex   String?
  logoDataUrl      String?
  // Per-field overrides on top of the base style (styleKey) — the real
  // "customize each part" controls: font, header layout, table header
  // style, logo shape. Null = inherit whatever the base style says, so
  // picking a style and never touching these still renders exactly like
  // that style always has.
  fontFamily       String? // "Helvetica" | "Times-Roman" | "Courier"
  headerLayout     String? // "centered" | "split" | "band"
  tableHeaderStyle String? // "dark" | "accent" | "line-only"
  logoShape        String? // "circle" | "square" | "none"
  // Superseded by `sections` below. Kept so templates saved before the
  // section builder existed still resolve; nothing writes them any more.
  sectionOrder     Json?
  hiddenSections   Json?
  // The section-by-section layout: an ordered array of
  // { key, visible, title, body, align, fields } — see lib/pdf/sections.ts.
  // Null means "the catalogue defaults", so a template nobody has edited
  // renders the standard document.
  sections         Json?
  // Colour beyond the accent. Null inherits the base style, so picking a
  // style and touching nothing renders exactly as that style always has.
  textColorHex     String?
  mutedColorHex    String?
  // Typography and page setup.
  fontScale        Float? // 0.85 - 1.25, multiplies every size
  pageSize         String? // "A5" | "A4" | "LETTER"
  orientation      String? // "portrait" | "landscape"
  // Coarse preset, set by the design presets. Superseded per-edge by the
  // four values below whenever the owner sets them explicitly.
  pageMargin       String? // "compact" | "normal" | "roomy"
  marginTopIn      Float?
  marginBottomIn   Float?
  marginLeftIn     Float?
  marginRightIn    Float?
  // Page background. Null = white, which is what a printed document wants
  // unless somebody deliberately decides otherwise.
  backgroundHex    String?
  // Which documents this template renders. A workspace usually wants a
  // different look for a delivery slip than for a proposal, which one
  // workspace-wide default could never express.
  appliesTo        String   @default("ALL") // ALL | QUOTE | INVOICE | SLIP
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@map("tenant_pdf_templates")
}

// ---------------------------------------------------------------------
// Built-in mail client — a BlueMail-style unified inbox. GOOGLE is a
// coming-soon connection type (needs a real OAuth app registered and
// verified with Google before it can do anything beyond sit disabled,
// same checkpoint class as Google Drive backup). IMAP is real today —
// the owner's own mail credentials, encrypted at rest (src/lib/crypto.ts)
// since this is meaningfully more sensitive than an API key. FLOW_HOSTED
// is a forwarding address unique to this tenant that flow ingests via
// webhook — no credentials to store at all.
// ---------------------------------------------------------------------

enum EmailProviderType {
  GOOGLE
  IMAP
  FLOW_HOSTED
}

model EmailAccount {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  provider           EmailProviderType
  emailAddress       String
  imapHost           String?
  imapPort           Int?
  imapUser           String?
  imapPasswordEnc    String? // AES-encrypted, never plaintext
  /// Sending, from the business's own address rather than ours — the reply a
  /// customer gets should come from the mailbox they wrote to.
  smtpHost           String?
  smtpPort           Int?
  smtpUser           String?
  smtpPasswordEnc    String?
  smtpSecure         Boolean           @default(true)
  fromName           String?
  flowInboundAddress String?           @unique // e.g. "acme-co@mail.flow.skynat.co"
  isActive           Boolean           @default(true)
  lastCheckedAt      DateTime?
  createdAt          DateTime          @default(now())

  emails InboundEmail[]
  sent   OutboundEmail[]

  @@index([tenantId])
  @@map("email_accounts")
}

enum EmailCategory {
  STATEMENT
  INVOICE
  LEGAL
  QUOTE_REPLY
  PAYMENT_REPLY
  OTHER
}

// Every inbound message that's been ingested (IMAP poll or webhook),
// classified by AI so statements/invoices/legal mail surfaces as
// important in the dashboard instead of getting buried in an inbox
// nobody checks — the actual problem this feature exists to solve.
model InboundEmail {
  id                    String        @id @default(cuid())
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  emailAccountId        String
  emailAccount          EmailAccount  @relation(fields: [emailAccountId], references: [id])
  fromAddress           String
  subject               String
  bodyText              String
  receivedAt            DateTime
  category              EmailCategory @default(OTHER)
  isImportant           Boolean       @default(false)
  looksLikePaymentProof Boolean       @default(false)
  aiSummary             String?
  // If the AI reads a scheduling cue in a quote reply ("call me back in
  // 2 weeks"), it links back to the quote and the follow-up cron reads
  // Transaction.nextFollowUpAt instead of the default cadence.
  linkedTransactionId   String?
  isRead                Boolean       @default(false)
  /// Who it was addressed to, the mail headers that thread it, and the
  /// customer it turned out to be from. Threading by hand beats threading by
  /// subject alone: two customers both write "Invoice".
  toAddress             String?
  messageId             String?
  inReplyTo             String?
  threadKey             String?
  partyId               String?
  party                 Party?        @relation(fields: [partyId], references: [id])
  isArchived            Boolean       @default(false)
  createdAt             DateTime      @default(now())

  @@index([tenantId, isRead])
  @@index([tenantId, category])
  @@index([tenantId, threadKey])
  @@map("inbound_emails")
}

enum NotificationType {
  HOT_LEAD
  IMPORTANT_EMAIL
  AUTO_FOLLOW_UP_SENT
  FOLLOW_UP_NEEDS_APPROVAL
  PAYMENT_PROOF_RECEIVED
  GENERAL
}

// One shared in-dashboard notification center — also the hub other
// channels (WhatsApp alert to the assigned salesperson today, push once
// there's a mobile push provider) fan out from, so there's a single
// record of "the business was told about this," not a different history
// per channel.
model Notification {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  membershipId    String? // null = visible to every member of the tenant
  type            NotificationType
  title           String
  body            String
  linkHref        String?
  isRead          Boolean          @default(false)
  sentViaWhatsApp Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([tenantId, isRead])
  @@index([tenantId, membershipId, isRead])
  @@map("notifications")
}

// Platform-wide (not per-tenant) settings a super-admin controls — today
// just which LLM provider powers every AI feature (proposals, email
// classification, follow-up drafting, onboarding extraction). A single
// fixed-id row rather than a real table, since there's exactly one of
// these per deployment; getAiModel() reads it so a provider switch takes
// effect immediately, no redeploy needed.
model PlatformSetting {
  id            String   @id @default("singleton")
  aiProvider    String   @default("anthropic") // "anthropic" | "google"
  // Which engine renders spoken voice (daily briefing, PA answers) when a
  // tenant's own character allowance for the period hasn't run out —
  // "browser" costs nothing and needs no key (client-side Web Speech API);
  // "google" is the paid Neural2 upgrade, only actually used once a
  // GOOGLE_TTS_API_KEY is configured. Safe to flip any time — this only
  // changes what a synth request tries first, nothing is stored per-voice.
  voiceProvider String   @default("browser") // "browser" | "google"
  // Platform-wide dashboard color skin — see ColorSkin in src/lib/ai/model.ts
  // for the current option list and src/app/globals.css
  // .kb-shell[data-skin] for the actual palettes. Chosen once here, applies
  // to every tenant; not a per-user preference. The column default below is
  // never actually read — getPlatformColorSkin() falls back to its own
  // DEFAULT_SKIN constant ("jewel") whenever this row is unset or invalid.
  colorSkin     String   @default("default")
  updatedAt     DateTime @updatedAt

  @@map("platform_settings")
}

// One row per tenant per calendar month — tracks how many characters of
// premium (Google) voice a tenant has used, so the synth route can fall
// back to free browser voice once their plan's allowance for the period
// is spent instead of ever hard-blocking. `period` is "YYYY-MM"; a tenant
// simply gets a fresh row (and fresh allowance) the moment the month
// rolls over — no cron/reset job needed.
model VoiceUsage {
  id             String   @id @default(cuid())
  tenantId       String
  period         String
  charactersUsed Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, period])
  @@map("voice_usage")
}

// Every external-service credential this app can use, settable from
// /admin/api-keys instead of only an env var — a super-admin can add or
// rotate a key without a redeploy. `key` is one of the fixed identifiers
// in src/lib/platform/apiKeys.ts (e.g. "ANTHROPIC_API_KEY"); `valueEnc` is
// AES-256-GCM encrypted (src/lib/crypto.ts) since these are always secrets.
// Reading always checks here first, falling back to the env var of the
// same name — nothing breaks for a deployment that only ever used env vars.
model PlatformApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  valueEnc  String
  updatedAt DateTime @updatedAt

  @@map("platform_api_keys")
}

// A tenant's connected calendar — live two-way sync for reminders. One
// per tenant today (Google only); the provider field exists so Outlook
// can be added later without a schema change. Tokens are AES-256-GCM
// encrypted at rest, same as IMAP passwords (src/lib/crypto.ts).
model CalendarIntegration {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  provider             String    @default("GOOGLE")
  refreshTokenEnc      String
  accessTokenEnc       String?
  accessTokenExpiresAt DateTime?
  calendarId           String    @default("primary")
  connectedByEmail     String? // whose Google account this is, shown in settings so it's obvious if the wrong person connected it
  createdAt            DateTime  @default(now())

  @@map("calendar_integrations")
}

// ============================================================================
// AGENT LAYER
// ============================================================================
// The agent is not a feature bolted next to the app — it is a second operator
// of the same Business Graph. That means it needs the three things any
// operator needs and a bolted-on chatbot doesn't: somewhere to remember, a
// record of what it did, and a defined limit on what it may do alone.

// How much this workspace lets the agent do without asking first. Deliberately
// per-tenant and not per-user: it is a statement about the business's appetite
// for autonomy, not one person's preference.
enum AgentAutonomy {
  SUGGEST_ONLY // never writes; proposes and waits
  REVERSIBLE // writes things that can be undone (drafts, tasks, notes)
  FULL // everything except money movement, which always asks
}

enum AgentRunTrigger {
  USER // someone typed or spoke a request
  SCHEDULE // the periodic tenant tick
  EVENT // something happened in the business
  AGENT // a named agent's own schedule
}

enum AgentRunStatus {
  RUNNING
  DONE
  FAILED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

// One conversation. Threads are per-user so a follow-up ("do the same for
// Jane") resolves against what that person said, not the whole workspace.
model AgentThread {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  title     String?
  channel   String         @default("web") // web | whatsapp | voice
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AgentMessage[]
  runs      AgentRun[]

  @@index([tenantId, userId])
  @@map("agent_threads")
}

model AgentMessage {
  id        String      @id @default(cuid())
  threadId  String
  thread    AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime    @default(now())

  @@index([threadId, createdAt])
  @@map("agent_messages")
}

// The audit trail for autonomy. Every run — typed, scheduled or event-driven —
// lands here with what it saw, what it decided and what it changed, so an
// action taken while nobody was watching is always attributable and, where
// the action supports it, undoable. This generalises the AiDraft queue, which
// only ever covered follow-up messages.
model AgentRun {
  id       String           @id @default(cuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  threadId String?
  thread   AgentThread?     @relation(fields: [threadId], references: [id])
  agentId  String?
  agent    AgentDefinition? @relation(fields: [agentId], references: [id])

  trigger        AgentRunTrigger
  status         AgentRunStatus  @default(RUNNING)
  // Who or what caused this. A user id for USER runs, an event id for EVENT
  // runs, null for the scheduled tick.
  actorUserId    String?
  input          String
  reply          String?
  // Ordered tool calls with their inputs and outputs, as JSON. This is what
  // the run detail page renders as "here is exactly what it did".
  steps          Json            @default("[]")
  // Set when the run stopped to ask. Holds the proposed tool calls so they
  // can be executed verbatim on approval rather than re-inferred.
  pendingActions Json?
  error          String?
  createdAt      DateTime        @default(now())
  finishedAt     DateTime?
  resolvedAt     DateTime?
  resolvedBy     String?

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("agent_runs")
}

// What the agent has learned about this workspace that isn't derivable from a
// query — payment habits, who to contact about what, standing instructions.
// Keyed so a fact can be updated rather than duplicated as it changes.
model TenantFact {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  value       String
  // Where this came from, so a wrong fact can be traced and removed.
  sourceRunId String?
  confidence  String   @default("observed") // observed | confirmed | stated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_facts")
}

// A named agent: a saved configuration of tools, autonomy and schedule. Once
// the runtime exists, "hire a collections agent" is a row here, not new code.
model AgentDefinition {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  // What this agent is for, in the owner's words. Goes into its system prompt.
  brief     String
  // Tool names it may use. Empty = every tool the triggering role allows.
  toolNames String[]      @default([])
  autonomy  AgentAutonomy @default(SUGGEST_ONLY)
  // Cron expression, evaluated by the tenant tick. Null = event/manual only.
  schedule  String?
  isActive  Boolean       @default(true)
  lastRunAt DateTime?
  createdAt DateTime      @default(now())
  runs      AgentRun[]

  @@index([tenantId, isActive])
  @@map("agent_definitions")
}

// Domain events emitted by the core layer. The agent subscribes to these so it
// reacts to the business changing, not only to the clock — a quote opened four
// times is a buying signal the moment it happens, not the next morning.
model DomainEvent {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String // quote.opened_repeatedly, invoice.overdue, payment.failed, ...
  subjectType String
  subjectId   String
  payload     Json      @default("{}")
  createdAt   DateTime  @default(now())
  // Null until the agent has looked at it. The tick claims a batch atomically
  // by stamping this, so two overlapping ticks can't both react to one event.
  processedAt DateTime?

  @@index([tenantId, processedAt])
  @@index([type, createdAt])
  @@map("domain_events")
}

/// Something went wrong on the road: assembled into the insurer's pack at
/// the scene, when the facts are still there, rather than a week later.
model Incident {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tripId      String?
  trip        Trip?    @relation(fields: [tripId], references: [id])
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id])
  driverId    String? // Membership.id
  at          DateTime @default(now())
  lat         Float?
  lng         Float?
  description String
  otherParty  String?
  /// Photographs, as data URLs — same pattern as receipts.
  photos      Json     @default("[]")
  /// What the pack still lacks, kept so the prompt is specific.
  missing     String[] @default([])
  status      String   @default("OPEN") // OPEN | SUBMITTED | CLOSED
  createdAt   DateTime @default(now())

  @@index([tenantId, at])
  @@map("incidents")
}

/// A field action captured on a phone, applied once. The id is generated on
/// the phone at the moment of the tap, so a capture retried after the signal
/// comes back is recognised and not applied twice — which is what lets the
/// app record an arrival with no signal and send it later.
model FieldSync {
  id        String   @id // client-generated
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String
  /// When it happened on the phone, which is not when it arrived here.
  capturedAt DateTime
  appliedAt  DateTime @default(now())
  result     String?

  @@index([tenantId, appliedAt])
  @@map("field_syncs")
}

/// A document, photograph or spreadsheet brought in while moving in, and what
/// was read from it. The file itself is not kept: what was read is, so every
/// field it filled in can say where it came from, and what was read stays
/// apart from what the owner confirmed.
model IntakeDocument {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName  String
  mediaType String
  /// What it turned out to be: company_registration, sales_document, price_list…
  kind      String
  summary   String?
  reading   Json
  /// READ until the owner confirms what to keep, then APPLIED or DISMISSED.
  status    String    @default("READ")
  appliedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@map("intake_documents")
}

enum DeliveryNoteStatus {
  DRAFT
  SENT
  DELIVERED
}

/// What actually went out of the door, against what was sold.
///
/// A packing slip and a delivery note are the same document read by two
/// people: the one loading the van, and the one signing for it. It is kept
/// apart from the invoice because a delivery is not always the whole invoice
/// — part orders, back orders and second trips are ordinary.
model DeliveryNote {
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  number        String
  status        DeliveryNoteStatus @default(DRAFT)
  partyId       String
  party         Party              @relation(fields: [partyId], references: [id])
  /// The invoice or quote this delivers against, when there is one.
  transactionId String?
  transaction   Transaction?       @relation(fields: [transactionId], references: [id])
  /// The stop that delivered it, so proof of delivery and the slip are one thing.
  tripStopId    String?
  deliveryAddress String?
  reference     String?
  notes         String?
  deliveredAt   DateTime?
  signedBy      String?
  createdById   String?
  createdAt     DateTime           @default(now())

  lines DeliveryNoteLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, transactionId])
  @@map("delivery_notes")
}

model DeliveryNoteLine {
  id          String       @id @default(cuid())
  noteId      String
  note        DeliveryNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  itemId      String?
  item        Item?        @relation(fields: [itemId], references: [id])
  description String
  quantity    Int
  unit        String?
  sortOrder   Int          @default(0)

  @@index([noteId])
  @@map("delivery_note_lines")
}

/// A message sent from the business's own mailbox.
///
/// Kept beside the inbound ones so a conversation reads as a conversation:
/// what the customer wrote, what was sent back, and who sent it.
model OutboundEmail {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  emailAccountId String?
  emailAccount   EmailAccount? @relation(fields: [emailAccountId], references: [id])
  toAddress      String
  ccAddress      String?
  subject        String
  bodyText       String
  /// The thread it belongs to, the same key the inbound side uses.
  threadKey      String?
  inReplyTo      String?
  messageId      String?
  partyId        String?
  party          Party?        @relation(fields: [partyId], references: [id])
  /// Who pressed send. Null when the platform sent it on a schedule.
  sentById       String?
  /// SENT, or FAILED with the reason — a message that did not go must say so.
  status         String        @default("SENT")
  error          String?
  sentAt         DateTime      @default(now())

  @@index([tenantId, sentAt])
  @@index([tenantId, threadKey])
  @@map("outbound_emails")
}

/// Something a customer did in their own portal.
///
/// The three things customers actually want to do and almost no portal in
/// this category lets them: send the proof of payment they just made, ask a
/// question about an invoice, and correct their own details. Each lands here
/// and is answered by a person — nothing a customer sends changes the books
/// on its own.
model PortalSubmission {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  partyId       String
  party         Party        @relation(fields: [partyId], references: [id])
  /// payment_proof | message | details
  kind          String
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  body          String?
  /// The file they attached, inline. Images are shrunk in the browser first.
  fileName      String?
  fileDataUrl   String?
  handledAt     DateTime?
  handledById   String?
  createdAt     DateTime     @default(now())

  @@index([tenantId, handledAt])
  @@index([tenantId, createdAt])
  @@map("portal_submissions")
}

enum AgreementKind {
  PROPOSAL
  SERVICE
  RETAINER
  SUPPLY
  NDA
  SUBCONTRACT
  OTHER
}

enum AgreementState {
  DRAFT
  SENT
  SIGNED
  DECLINED
  EXPIRED
}

/// A proposal or a contract — the document a deal is actually made on.
///
/// A quote is a price. The thing that wins the work, and the thing that
/// settles the argument eighteen months later, is prose: what is being done,
/// by when, what it costs, who owns what, and what happens when somebody
/// stops paying. Every small business writes these in Word, keeps them in a
/// folder, and cannot tell you which ones are signed.
///
/// Clauses are stored as ordered prose rather than a rigid field per term,
/// because a maintenance retainer and a sub-contract share almost no fields
/// and every attempt to model them as one shape produces a form nobody can
/// fill in. The library in agreements.ts supplies the starting points.
model Agreement {
  id                  String          @id @default(cuid())
  tenantId            String
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  partyId             String
  party               Party           @relation(fields: [partyId], references: [id])
  number              String
  kind                AgreementKind   @default(PROPOSAL)
  status              AgreementState  @default(DRAFT)
  title               String
  /// Ordered prose: [{ heading, body }]. The document, in the order it reads.
  clauses             Json
  /// What it is worth, and how often — null on something with no money in it.
  valueCents          Int?
  /// once | monthly | quarterly | annually
  recurrence          String?
  currency            String?
  startsAt            DateTime?
  endsAt              DateTime?
  /// A proposal goes stale; a contract does not.
  validUntil          DateTime?
  /// The quote this prices, where it came from one.
  transactionId       String?
  transaction         Transaction?    @relation(fields: [transactionId], references: [id])
  sentAt              DateTime?
  /// Countersigned by the customer, through their own portal link. The hash
  /// binds the clauses, the value and the signature together, so any later
  /// edit to the text is detectable by recomputing it.
  signedAt            DateTime?
  signatureDataUrl    String?
  signerName          String?
  signerIp            String?
  acceptanceHash      String?
  declinedAt          DateTime?
  /// Signed on the business's side before it went out.
  ourSignerName       String?
  ourSignatureDataUrl String?
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, partyId])
  @@map("agreements")
}

/// Something else the business runs, that flow sits underneath rather than
/// replacing on day one.
///
/// Nobody rips out the till on a Tuesday because a new system asked them to.
/// The honest way in is to be the engine under whatever they already use —
/// take their history, keep taking their daily numbers, and let the case for
/// moving the rest of it be made by what they can see here and cannot see
/// there. This row is what the business says they run, and what has actually
/// come across from it so far.
model ConnectedSystem {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  /// A key from the catalogue in core/systems.ts, or "other".
  systemKey        String
  /// What they call it, when it is not one in the catalogue.
  label            String?
  /// till | accounting | store | spreadsheet | documents | payroll | other
  category         String
  /// Whether the business's real records still live there rather than here.
  /// The whole switchover arc is this flag going false, one system at a time.
  isSystemOfRecord Boolean   @default(true)
  lastImportAt     DateTime?
  importedRecords  Int       @default(0)
  notes            String?
  /// Set when they stop using it. Kept rather than deleted: what somebody
  /// moved off, and when, is the most useful thing to know a year later.
  retiredAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, systemKey])
  @@index([tenantId])
  @@map("connected_systems")
}

// ---------------------------------------------------------------- the money
// Phases 16-22: the parts of getting paid, and of paying, that a business
// does every month and that no amount of invoicing software covers on its own.

/// An invoice somebody is paying off over time.
///
/// Most small businesses already do this — "half now, half end of month" — and
/// record it nowhere, so the overdue list says the whole amount is late from
/// the day after the invoice date. A plan is what makes the arrears figure
/// tell the truth: only the instalments actually past their day are overdue.
model PaymentPlan {
  id            String                 @id @default(cuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  transactionId String                 @unique
  transaction   Transaction            @relation(fields: [transactionId], references: [id])
  /// Taken up front, before the schedule starts.
  depositCents  Int                    @default(0)
  note          String?
  agreedById    String?
  cancelledAt   DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  instalments   PaymentPlanInstalment[]

  @@index([tenantId])
  @@map("payment_plans")
}

model PaymentPlanInstalment {
  id          String      @id @default(cuid())
  planId      String
  plan        PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dueOn       DateTime
  amountCents Int
  sortOrder   Int         @default(0)

  @@index([planId])
  @@map("payment_plan_instalments")
}

/// A rate between two currencies on a day.
///
/// Cached rather than fetched per document, because the rate that matters is
/// the one on the day the document was issued and that rate never changes
/// again. A row here is a fact about a past day, so it is written once.
model FxRate {
  id     String   @id @default(cuid())
  base   String
  quote  String
  rate   Float
  onDate DateTime
  /// Where it came from, so a hand-typed rate is never mistaken for a fetched one.
  source String   @default("manual")

  @@unique([base, quote, onDate])
  @@index([base, quote])
  @@map("fx_rates")
}

enum BillStatus {
  AWAITING_APPROVAL
  APPROVED
  PAID
  VOID
}

/// A supplier's invoice, before it is paid.
///
/// An expense is money that has already gone. A bill is money that has not
/// gone yet and has a date by which it must — which is the whole of what a
/// payables ledger is, and what tells an owner on the 25th what Friday costs.
model SupplierBill {
  id              String      @id @default(cuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  supplierId      String?
  supplier        Party?      @relation(fields: [supplierId], references: [id])
  /// The name off the invoice when the supplier is not on file yet.
  supplierName    String?
  reference       String?
  issuedOn        DateTime    @default(now())
  dueOn           DateTime
  amountCents     Int
  taxCents        Int?
  currency        String?
  status          BillStatus  @default(AWAITING_APPROVAL)
  approvedById    String?
  approvedAt      DateTime?
  paidCents       Int         @default(0)
  paidAt          DateTime?
  paymentRunId    String?
  paymentRun      PaymentRun? @relation(fields: [paymentRunId], references: [id])
  purchaseOrderId String?
  /// The cost row this became once it was paid.
  expenseId       String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, dueOn])
  @@index([tenantId, supplierId])
  @@map("supplier_bills")
}

/// A batch of bills paid together, which is how anybody with more than a
/// handful of suppliers actually pays: once a week, everything due.
model PaymentRun {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  runOn       DateTime
  /// DRAFT while it is being assembled; RELEASED once the money has gone.
  status      String         @default("DRAFT")
  totalCents  Int            @default(0)
  createdById String?
  releasedAt  DateTime?
  createdAt   DateTime       @default(now())
  bills       SupplierBill[]

  @@index([tenantId, status])
  @@map("payment_runs")
}

/// A VAT period, with its boxes frozen at the moment it was filed.
///
/// The figures are recomputed from the ledger until the return is filed, and
/// never afterwards — a return that silently restates when a backdated invoice
/// arrives is worse than no return, because it disagrees with the one the
/// revenue service already has.
model VatReturn {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  /// [{ code, label, cents }] in the order they appear on the form.
  boxes       Json
  outputCents Int
  inputCents  Int
  netCents    Int
  /// DRAFT | FILED
  status      String    @default("DRAFT")
  filedAt     DateTime?
  filedById   String?
  /// The reference the revenue service gave back.
  reference   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, periodStart, periodEnd])
  @@index([tenantId, status])
  @@map("vat_returns")
}

/// One rung of the chasing ladder, on one invoice.
///
/// Recorded so the next message knows what the last one said. A business that
/// sends the same polite reminder six times is not chasing, and one that opens
/// with a lawyer's letter loses the customer — the ladder is the difference,
/// and it only works if every rung is written down.
model CollectionAttempt {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  partyId       String
  party         Party       @relation(fields: [partyId], references: [id])
  /// Which rung: 1 is a nudge, the last is a final demand.
  step          Int
  /// whatsapp | email | call | letter
  channel       String
  /// gentle | firm | final
  tone          String
  body          String?
  sentById      String?
  sentAt        DateTime    @default(now())

  @@index([tenantId, transactionId])
  @@index([tenantId, sentAt])
  @@map("collection_attempts")
}

/// What somebody corrected about a coded cost, so it is not asked twice.
///
/// The machine reads a slip and codes it; a person disagrees and fixes it.
/// Without this the same supplier is miscoded every month forever, which is
/// how people stop trusting the reading and go back to typing.
model ExpenseCodingRule {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  /// Lowercased supplier name, or a phrase off the slip.
  matchOn        String
  accountId      String?
  category       String?
  isOwnerDrawing Boolean?
  timesApplied   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, matchOn])
  @@index([tenantId])
  @@map("expense_coding_rules")
}

// ------------------------------------------------------------- the inbox
// Phases 23-34: everything that happens between a business and a customer,
// in one place, with the rules that keep it legal and the mechanics that
// keep a shared inbox from becoming a pile nobody owns.

/// Whether this person has said we may contact them on a channel.
///
/// POPIA and its equivalents turn this from a nicety into the thing that
/// decides whether a broadcast is marketing or a fine. Stored per channel
/// because somebody who is happy to get an invoice by email is not
/// necessarily happy to get a special offer by WhatsApp.
model ContactConsent {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  partyId   String
  party     Party    @relation(fields: [partyId], references: [id])
  /// whatsapp | sms | email | call
  channel   String
  /// granted | withdrawn
  state     String
  /// Where it came from — a form, a reply, a conversation. What makes it defensible.
  source    String?
  note      String?
  changedAt DateTime @default(now())

  @@unique([tenantId, partyId, channel])
  @@index([tenantId, channel, state])
  @@map("contact_consents")
}

/// A customer conversation, and who owns it.
///
/// The messages already exist; what did not was anybody being responsible for
/// one. A shared inbox without assignment is a pile everybody assumes
/// somebody else is reading, and the clock below is what makes "we get back
/// to people quickly" a number rather than a belief.
model Conversation {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  /// The mailbox thread key, or `party:<id>` for a conversation on another channel.
  threadKey      String
  partyId        String?
  party          Party?             @relation(fields: [partyId], references: [id])
  assignedToId   String?
  /// OPEN | SNOOZED | CLOSED
  status         String             @default("OPEN")
  snoozedUntil   DateTime?
  /// When the customer last wrote and has not been answered since. The clock.
  waitingSince   DateTime?
  /// How long the first answer took, kept so the average is a real measurement.
  firstReplyMins Int?
  closedAt       DateTime?
  closedById     String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  notes          ConversationNote[]

  @@unique([tenantId, threadKey])
  @@index([tenantId, status])
  @@index([tenantId, assignedToId])
  @@map("conversations")
}

/// Something said about a conversation rather than in it. Never sent.
model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@map("conversation_notes")
}

/// A phone call, in or out.
///
/// The single highest-return automation in this category is answering a
/// missed call with a message within the minute, and it cannot exist without
/// somewhere to record that the call happened.
model CallLog {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  partyId         String?
  party           Party?    @relation(fields: [partyId], references: [id])
  fromNumber      String
  toNumber        String
  /// in | out
  direction       String
  /// answered | missed | voicemail
  status          String
  durationSeconds Int?
  recordingUrl    String?
  /// What was said, when somebody wrote it down.
  summary         String?
  /// Set when a missed call was answered by a message.
  respondedAt     DateTime?
  respondedWith   String?
  startedAt       DateTime  @default(now())

  @@index([tenantId, startedAt])
  @@index([tenantId, status])
  @@map("call_logs")
}

/// A form that turns a stranger into a lead.
model LeadForm {
  id          String           @id @default(cuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  slug        String
  title       String
  intro       String?
  /// [{ name, label, type, required }] — the questions, in order.
  fields      Json
  /// What goes back the second it is submitted. An instant answer is most of
  /// why one business wins a job and the one down the road does not.
  autoReply   String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  submissions LeadSubmission[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("lead_forms")
}

model LeadSubmission {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  formId    String
  form      LeadForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  /// The answers as given.
  answers   Json
  partyId   String?
  party     Party?   @relation(fields: [partyId], references: [id])
  /// web | qr | widget
  source    String?
  handledAt DateTime?
  createdAt DateTime @default(now())

  @@index([tenantId, handledAt])
  @@index([formId])
  @@map("lead_submissions")
}

/// One message to many people, and the record of who was left out and why.
///
/// The skipped list is the important half. A broadcast that quietly drops
/// people who withdrew consent looks identical to one that never checked.
model Broadcast {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  /// whatsapp | sms | email
  channel      String
  subject      String?
  body         String
  /// { sent: [...], skipped: [{ partyId, name, reason }] }
  audience     Json
  sentCount    Int       @default(0)
  skippedCount Int       @default(0)
  /// DRAFT | SENT
  status       String    @default("DRAFT")
  sentAt       DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@map("broadcasts")
}

// ----------------------------------------------------------- work and site
// Phases 35-46: the parts of doing the work that decide the margin, and the
// paperwork that decides whether it can be done at all.

/// A list of things that must happen before a job can be called done.
///
/// Not a nicety. In half the trades this list is the difference between work
/// that passes inspection and work that has to be redone, and it lives in
/// somebody's head — so when that person is off, the job is done differently.
model Checklist {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  name      String
  /// What kind of job this is for, so the right list is offered.
  forWork   String?
  /// Whether a job using it can be completed with items outstanding.
  enforced  Boolean         @default(true)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     ChecklistItem[]
  jobCards  JobCard[]

  @@index([tenantId])
  @@map("checklists")
}

model ChecklistItem {
  id          String    @id @default(cuid())
  checklistId String
  checklist   Checklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  text        String
  /// Whether a photograph is required to tick it. What makes proof, proof.
  needsPhoto  Boolean   @default(false)
  sortOrder   Int       @default(0)

  @@index([checklistId])
  @@map("checklist_items")
}

/// The certificate a job produces — a certificate of compliance, a test
/// report, a service record.
///
/// Issued from the job rather than typed afterwards, because a certificate
/// written from memory a week later is the one that is wrong.
model Certificate {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  jobCardId   String?
  jobCard     JobCard?  @relation(fields: [jobCardId], references: [id])
  partyId     String?
  party       Party?    @relation(fields: [partyId], references: [id])
  /// coc | test-report | service-record | other
  kind        String
  number      String
  title       String
  /// The findings, in the order they are printed. [{ heading, body }]
  body        Json
  issuedOn    DateTime  @default(now())
  /// When it stops being valid. What the compliance calendar watches.
  expiresOn   DateTime?
  issuedBy    String?
  /// The person's registration number, where the trade requires one.
  issuerRef   String?
  signatureDataUrl String?
  createdAt   DateTime  @default(now())

  @@unique([tenantId, number])
  @@index([tenantId, expiresOn])
  @@map("certificates")
}

/// Something captured on a phone with no signal, waiting to be applied.
///
/// The field already has a sync route for trips and proof; this is the
/// general version, so anything a phone can do offline queues the same way
/// and is applied in the order it happened rather than the order it arrives.
model OfflineChange {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  /// Who made it, so it is attributed to them and not to whoever synced.
  membershipId String
  /// The idempotency key the phone generated. A change applied twice is the
  /// whole failure mode of an offline queue.
  clientRef   String
  /// What to do: job.complete | checklist.tick | time.clockIn | expense.capture …
  kind        String
  payload     Json
  /// When it actually happened, which is not when it arrived.
  happenedAt  DateTime
  appliedAt   DateTime?
  /// Set when it could not be applied, with the reason, rather than dropped.
  failedAt    DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([tenantId, clientRef])
  @@index([tenantId, appliedAt])
  @@map("offline_changes")
}

// ----------------------------------------------------------------- the agent
// Phases 57-70: what makes an agent that acts on a business trustworthy
// rather than alarming — a way back, a budget, and a record of whether what
// it did actually worked.

/// How to undo one thing the agent did.
///
/// Autonomy is only sellable with a way back. The gate stops the irreversible
/// things; this covers everything else, which is most of what it does — and
/// "I can put that back" is the sentence that lets somebody turn the agent up
/// a notch.
///
/// The compensation is recorded at the time of the action, because working
/// out how to reverse something a week later needs state that has moved on.
model AgentUndo {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  runId        String?
  /// The tool that did it, for the sentence shown to a person.
  tool         String
  /// What it did, in the words of somebody reading a list of them.
  description  String
  /// How to put it back: { kind, ...args }. Read by agent/undo.ts.
  compensation Json
  /// Who or what did it.
  actedById    String?
  undoneAt     DateTime?
  undoneById   String?
  /// Set when putting it back failed, with the reason.
  failedReason String?
  /// Undo is offered for a week. After that the world has moved.
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, undoneAt])
  @@map("agent_undo")
}

/// What the agent cost, per run.
///
/// A business that cannot see what its agent costs cannot be asked to trust
/// it with more. Recorded per run so a budget can be enforced before the
/// next one rather than discovered on an invoice.
model AgentSpend {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  runId        String?
  agentId      String?
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  /// What it cost, in the platform's own currency, at the rate when it ran.
  costCents    Float    @default(0)
  at           DateTime @default(now())

  @@index([tenantId, at])
  @@map("agent_spend")
}

/// A named agent somebody wrote, packaged so another business can install it.
///
/// A marketplace with no code in it: a recipe is a name, a brief, a schedule
/// and the tools it may use. Everything it can do is already bounded by the
/// installing workspace's own roles and autonomy, so installing one is not a
/// security decision.
model AgentRecipe {
  id          String   @id @default(cuid())
  /// Null for one published by the platform rather than by a workspace.
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  slug        String   @unique
  name        String
  summary     String
  /// What it is told to do.
  brief       String
  /// Cron-ish schedule, or null to run only when asked.
  schedule    String?
  /// Tool names it may use. Narrowing, never widening.
  tools       String[]
  /// Which trades it suits, for the list. Empty means any.
  niches      String[]
  installs    Int      @default(0)
  publishedAt DateTime @default(now())

  @@index([tenantId])
  @@map("agent_recipes")
}
