// KasiBiz core data model — one shared engine, many niche "skins".
// Party / Item / Transaction / Event, per the strategic report's architecture.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URL lives in prisma.config.ts (for Migrate) and is
// passed via an adapter to the PrismaClient constructor (src/lib/db.ts) —
// it's no longer valid inside the schema's datasource block.
datasource db {
  provider = "postgresql"
}

enum PartyRole {
  CUSTOMER
  SUPPLIER
  STAFF
  PATIENT // Medical niche — appointment/visit tracking only, no clinical/health data fields
  MEMBER // Non-profit niche
  SPONSOR // Non-profit niche — partners/sponsors, distinct from individual members
}

enum TransactionType {
  QUOTE
  INVOICE
  PAYMENT
  STOCK_ADJUSTMENT
  REFUND
}

enum QuoteKind {
  BASIC // plain line-item quote, no narrative content
  PROPOSAL // adds an intro + scope-of-work section above the line items
}

enum TransactionStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum EventType {
  SITE_VISIT
  DELIVERY
  INSTALL
  STOCK_TRANSFER
  FOLLOW_UP_SENT
  CONSULTATION // Medical niche — an appointment/visit record, non-clinical
  ORDER_PLACED // Ecommerce niche — order confirmed, ahead of fulfillment
  PROPERTY_INSPECTION // Property niche — inspection/maintenance visit
}

enum NicheSkin {
  CORPORATE
  SERVICES
  LOGISTICS
  MEDICAL
  RETAIL
  WHOLESALE
  ECOMMERCE
  NONPROFIT
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Tenant {
  id                           String          @id @default(cuid())
  name                         String
  niche                        NicheSkin       @default(SERVICES)
  // Public booking page config: { enabled, workDays: [1-5], startHour,
  // endHour, slotMins }. Null/absent = booking page not set up yet.
  bookingConfig                Json?
  googleReviewUrl              String? // customer-facing link sent in the post-payment review request
  // Owner-controlled empathy dial on the escalating follow-up engine —
  // chase payment without torching the relationship. Applied to every
  // touch's tone, not just the final one.
  collectionsTone              CollectionsTone @default(STANDARD)
  // Doc backup — daily copy of new documents (signed quotes, filings,
  // lease contracts) to the owner's own cloud storage. Checkpoint: needs
  // real Google OAuth app registration before this does anything beyond
  // logging — same graceful-degradation pattern as WhatsApp/R2.
  docBackupProvider            String? // "google_drive" | null = not connected
  docBackupConnected           Boolean         @default(false)
  // Follow-up cadence, owner-controlled — taking the "when do we nudge
  // them" decision off a person's daily mental checklist entirely.
  // windowDays = days of silence before the first follow-up fires;
  // repeatDays = days between each escalation after that.
  followUpWindowDays           Int             @default(3)
  followUpRepeatDays           Int             @default(3)
  // When on, an AI-drafted follow-up sends automatically instead of
  // waiting in the AiDraft queue for a human Approve click — the
  // confirm-before-send guardrail, made optional per tenant rather than
  // mandatory, since some owners want the daily task gone entirely.
  autoRespondEnabled           Boolean         @default(false)
  // PA voice plan — controls how many characters of premium (Google)
  // voice this tenant gets per period before falling back to free browser
  // voice for the rest of it. "free" = 20,000/month, "starter" =
  // 60,000/month, "unlimited" = 10,000/day (never actually blocks; past
  // the daily allowance it's free browser voice until the day resets).
  voicePlan                    String          @default("free")
  // Banking details shown on invoice PDFs for EFT payment, plus the
  // official WhatsApp number a customer can message to verify a document
  // is genuinely from this business — an anti-impersonation measure, so
  // it's deliberately settable only by an OWNER (see settings/banking),
  // never a capability any staff role gets, to reduce the "a compromised
  // or dishonest staff account swaps the bank account" fraud path.
  // Business details that appear on every document. A valid tax invoice in
  // South Africa has to carry the supplier's name, address and VAT number —
  // the PDF renderer has had fields for these since it was written, and
  // nothing ever populated them, so every invoice this app produced was
  // missing them.
  // Where this business is regulated. Nothing in the compliance engine is
  // hardcoded to a country — these two fields are what select a jurisdiction's
  // obligations out of the shared library, and a workspace in Texas gets Texas
  // rows by the same code path that gives a Johannesburg one CIPC.
  countryCode                  String? // ISO 3166-1 alpha-2: "ZA", "US", "GB"
  regionCode                   String? // state or province, where it changes what you owe: "CA", "TX", "GP"
  // The entity type in the owner's own words — "Pty Ltd", "LLC", "Sole Trader".
  // Deliberately free text: an enum of company types is a geo-lock wearing a
  // different hat.
  entityType                   String?
  businessAddress              String?
  businessEmail                String?
  businessPhone                String?
  vatNumber                    String?
  registrationNumber           String?
  bankName                     String?
  bankAccountHolder            String?
  bankAccountNumber            String?
  bankBranchCode               String?
  bankSwift                    String?
  // How much this workspace lets the agent do on its own. See AgentAutonomy.
  agentAutonomy                AgentAutonomy   @default(SUGGEST_ONLY)
  // Master switch for the proactive layer. Off means the agent only ever
  // responds when spoken to — no tick, no event reactions, no nudges.
  agentProactiveEnabled        Boolean         @default(true)
  whatsappVerifyNumber         String?
  // AI-generated proposal content is metered — the LLM call only writes
  // text (never the PDF design/layout, which stays fixed code, both for
  // cost and for visual consistency), but text generation still costs
  // real tokens per call. Simple monthly counter, resets on read once the
  // month rolls over rather than needing a cron job.
  aiProposalGenerationsUsed    Int             @default(0)
  aiProposalGenerationsResetAt DateTime        @default(now())
  createdAt                    DateTime        @default(now())

  memberships            Membership[]
  parties                Party[]
  items                  Item[]
  purchaseOrders         PurchaseOrder[]
  jobCards               JobCard[]
  transactions           Transaction[]
  events                 Event[]
  tasks                  Task[]
  recurringInvoices      RecurringInvoice[]
  comments               Comment[]
  proposalTemplates      ProposalTemplate[]
  aiDrafts               AiDraft[]
  disputes               Dispute[]
  apiKeys                ApiKey[]
  itemBatches            ItemBatch[]
  notes                  Note[]
  goals                  Goal[]
  expenses               Expense[]
  messageThreads         MessageThread[]
  timeEntries            TimeEntry[]
  fuelLogs               FuelLog[]
  stocktakes             Stocktake[]
  insuranceClaims        InsuranceClaim[]
  membershipInvolvements MembershipInvolvement[]
  donations              Donation[]
  complianceFilings      ComplianceFiling[]
  rentals                Rental[]
  properties             Property[]
  leases                 Lease[]
  tillSessions           TillSession[]
  posIntegrations        PosIntegration[]
  paymentGateways        PaymentGateway[]
  paymentCheckouts       PaymentCheckout[]
  ecommerceIntegrations  EcommerceIntegration[]
  calendarIntegration    CalendarIntegration?
  ecommerceOrders        EcommerceOrder[]
  pdfTemplates           TenantPdfTemplate[]
  emailAccounts          EmailAccount[]
  inboundEmails          InboundEmail[]
  notifications          Notification[]
  webhookEndpoints       WebhookEndpoint[]

  connectionsAsSupplier WholesaleConnection[] @relation("SupplierConnections")
  connectionsAsBuyer    WholesaleConnection[] @relation("BuyerConnections")
  agentThreads          AgentThread[]
  agentRuns             AgentRun[]
  tenantFacts           TenantFact[]
  agentDefinitions      AgentDefinition[]
  domainEvents          DomainEvent[]

  obligations Obligation[]

  @@map("tenants")
}

// A login is global, not scoped to one business — one email, one password,
// any number of businesses. isSuperAdmin is the platform operator's own
// account type: it can see and act across every tenant regardless of
// membership, for support and cross-business oversight. This is distinct
// from an OWNER membership, which only grants access to that one business.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String? // WhatsApp-reachable — where the daily briefing goes
  passwordHash String? // null = account exists (e.g. added by a staff invite) but hasn't been claimed with a password yet
  isSuperAdmin Boolean  @default(false)
  totpSecret   String? // base32, set once 2FA setup is confirmed
  totpEnabled  Boolean  @default(false)
  createdAt    DateTime @default(now())

  memberships Membership[]

  @@map("users")
}

// Join table: which businesses a login can access, and what they can do in
// each one. The same person can be OWNER of one business and STAFF of
// another — e.g. a wholesaler's owner who is also a retailer's buyer-side
// contact. Role granularity (OWNER/STAFF/DRIVER/REP/TECHNICIAN) matches the
// Role type in src/lib/core/access.ts.
model Membership {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  role       String       @default("OWNER") // OWNER | STAFF | DRIVER | REP | TECHNICIAN
  // Org hierarchy — additive on top of the per-staff account that already
  // existed (Membership = one person's account on one business). Optional:
  // a flat team with no managers set is still perfectly valid.
  managerId  String?
  manager    Membership?  @relation("ManagerOf", fields: [managerId], references: [id])
  reports    Membership[] @relation("ManagerOf")
  department String?
  createdAt  DateTime     @default(now())

  transactionsAsSalesPerson Transaction[]
  jobCardsAssigned          JobCard[]

  obligations Obligation[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("memberships")
}

enum JobCardStatus {
  SCHEDULED
  IN_PROGRESS
  DONE
}

// A work order for a service business — "job cards" per the user's own
// term (solar install crews, contractors). Deliberately linked to a
// Transaction (usually the ACCEPTED quote/invoice) rather than floating
// free, since a job card's whole point is "the physical work behind this
// sale" — pricing/line-items stay on the Transaction, this only tracks
// getting the work done. A checklist (JobCardTask) covers the common
// "make sure every step actually happened" need without inventing a
// separate generic task system.
model JobCard {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  transactionId      String
  transaction        Transaction   @relation(fields: [transactionId], references: [id])
  partyId            String
  party              Party         @relation(fields: [partyId], references: [id])
  title              String
  assignedToId       String?
  assignedTo         Membership?   @relation(fields: [assignedToId], references: [id])
  status             JobCardStatus @default(SCHEDULED)
  scheduledAt        DateTime?
  notes              String?
  completionPhotoUrl String?
  createdAt          DateTime      @default(now())
  completedAt        DateTime?

  tasks JobCardTask[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("job_cards")
}

model JobCardTask {
  id        String  @id @default(cuid())
  jobCardId String
  jobCard   JobCard @relation(fields: [jobCardId], references: [id])
  label     String
  isDone    Boolean @default(false)
  sortOrder Int     @default(0)

  @@map("job_card_tasks")
}

// People: customers, suppliers, staff — one address book, one table.
model Party {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  role        PartyRole
  name        String
  phone       String? // WhatsApp-reachable number, E.164
  email       String?
  notes       String?
  // Richer contact/mapping fields for a proper customer record, not just
  // a name+number — printed on quotes/invoices and usable in reporting.
  companyName String?
  vatNumber   String?
  addressLine String?
  city        String?
  postalCode  String?
  country     String?
  // Customer portal — a token-login link (Soler's proven pattern,
  // generalized onto the shared Party model), no password needed. Lazily
  // generated the first time a portal link is requested for this party.
  portalToken String?   @unique
  createdAt   DateTime  @default(now())

  transactions             Transaction[]
  events                   Event[]
  recurringInvoices        RecurringInvoice[]
  aiDrafts                 AiDraft[]
  disputes                 Dispute[]
  membershipInvolvements   MembershipInvolvement[]
  donations                Donation[]
  rentals                  Rental[]
  leasesAsRenter           Lease[]
  purchaseOrdersAsSupplier PurchaseOrder[]
  jobCards                 JobCard[]

  obligations Obligation[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@map("parties")
}

// Items: stock, services, catalog entries — shared across retail/wholesale/services.
model Item {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  name            String
  // The explanatory line printed under the item name on a document — what it
  // is, what it includes, which standard it complies with. The PDF renderer
  // has a column switch for these; without somewhere to write them it would
  // be a switch that does nothing.
  description     String?
  // "m", "pcs", "hours" — printed under the quantity on a document.
  unit            String?
  sku             String?
  hsnCode         String? // HSN/tax-classification code, shown alongside SKU on the line item
  unitPriceCents  Int
  costCents       Int? // for margin reporting — optional, owner may not track cost
  taxRatePercent  Int? // e.g. 15 for 15% VAT; null = no tax applied
  category        String?
  imageUrl        String?
  isActive        Boolean         @default(true) // soft-hide from the catalog picker without deleting history
  stockQty        Int? // null = service line item, not stock-tracked
  reorderPoint    Int?
  minOrderQty     Int? // wholesale MOQ — null = no minimum enforced
  // Rentals — platform-wide, not tied to one niche. An Item can be
  // rentable instead of (or as well as) sellable.
  isRentable      Boolean         @default(false)
  rentalRateCents Int?
  rentalRateUnit  RentalRateUnit?
  createdAt       DateTime        @default(now())

  transactionLines   TransactionLine[]
  batches            ItemBatch[]
  purchaseOrderLines PurchaseOrderLine[]
  stocktakes         Stocktake[]
  rentals            Rental[]

  obligations Obligation[]

  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("items")
}

// Optional per-batch stock tracking, additive on top of Item.stockQty —
// only needed for perishable/expiring inventory (FEFO waste reduction).
// Items that never set a batch just don't get expiry-risk tracking.
model ItemBatch {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  itemId     String
  item       Item      @relation(fields: [itemId], references: [id])
  quantity   Int
  receivedAt DateTime  @default(now())
  expiresAt  DateTime? // null = non-perishable, not tracked for waste risk
  createdAt  DateTime  @default(now())

  @@index([tenantId])
  @@index([itemId, expiresAt])
  @@map("item_batches")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  RECEIVED
}

// PA job: turning a reorder suggestion (src/lib/core/inventory.ts
// getReorderSuggestions) into a real, sendable document instead of just
// a number on a dashboard. Deliberately its own model, not a Transaction
// row — a PO is a commitment to a supplier, not a sale, and mixing it
// into the sales ledger would break every report that sums Transaction
// amounts as revenue.
model PurchaseOrder {
  id             String              @id @default(cuid())
  tenantId       String
  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  supplierId     String
  supplier       Party               @relation(fields: [supplierId], references: [id])
  status         PurchaseOrderStatus @default(DRAFT)
  totalCostCents Int
  createdAt      DateTime            @default(now())
  sentAt         DateTime?
  receivedAt     DateTime?

  lines PurchaseOrderLine[]

  @@index([tenantId])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  itemId          String
  item            Item          @relation(fields: [itemId], references: [id])
  quantity        Int
  unitCostCents   Int

  @@map("purchase_order_lines")
}

// Money: append-only ledger. Quotes, invoices, payments — one typed table,
// never mutated after creation, only superseded by a new row referencing it.
model Transaction {
  id                      String            @id @default(cuid())
  tenantId                String
  tenant                  Tenant            @relation(fields: [tenantId], references: [id])
  partyId                 String
  party                   Party             @relation(fields: [partyId], references: [id])
  type                    TransactionType
  status                  TransactionStatus @default(DRAFT)
  amountCents             Int
  parentId                String? // e.g. an INVOICE points back at the QUOTE it came from
  parent                  Transaction?      @relation("TransactionLineage", fields: [parentId], references: [id])
  children                Transaction[]     @relation("TransactionLineage")
  createdAt               DateTime          @default(now())
  dueAt                   DateTime?
  respondedAt             DateTime? // when the customer last replied/acted — drives the follow-up engine
  signatureDataUrl        String? // customer's e-signature on quote acceptance, captured via the portal
  // Acceptance audit trail — the difference between "we have a drawn
  // signature" and "this holds up as a real contract record." The hash
  // binds the amount/lines/signature/timestamp together so any later
  // tampering with the quote is detectable by recomputing and comparing.
  acceptanceIp            String?
  acceptanceHash          String?
  reviewRequestSentAt     DateTime? // fires once, the moment an invoice first reaches PAID
  // Who this quote/invoice is attributed to — shown on the document (with
  // their contact details, if the tenant opts in) so the customer knows
  // exactly who to reach, and lets reporting break down sales by person.
  salesPersonMembershipId String?
  salesPersonMembership   Membership?       @relation(fields: [salesPersonMembershipId], references: [id])
  // Whole-document discount, applied on top of the line-level discounts —
  // matches the "Discount %" field on the totals block of most invoicing
  // tools. amountCents already reflects this once applied; kept here too
  // so the PDF/online view can show the breakdown, not just the result.
  discountPercent         Float?            @default(0)
  // Free-text business fields shown on the document alongside the line
  // items — subject line and a PO/reference number, the two fields every
  // real invoicing tool has that this one didn't.
  subject                 String?
  poNumber                String?
  // Quote presentation (BASIC vs PROPOSAL). Only meaningful on QUOTE rows;
  // introText/scopeOfWork are populated for PROPOSAL and shown above the
  // line items on both the web link and the PDF.
  quoteKind               QuoteKind?        @default(BASIC)
  introText               String?
  scopeOfWork             String?
  // Extra fields for a PROPOSAL-kind quote's project info — populated by
  // AI (src/lib/ai/proposal.ts) from the line items plus projectLocation,
  // the one field a human has to actually type in. The AI only ever
  // writes text into these fields; the PDF layout/design is fixed code,
  // never generated, so this stays fast, cheap, and visually consistent.
  projectLocation         String?
  performanceExpectancy   String?
  projectTimeline         String?
  systemInfo              String?
  // Quote-open tracking (Soler's hot-lead pattern): a customer opening the
  // portal link for a quote is a buying signal, tracked independent of
  // whether they've responded yet.
  openCount               Int               @default(0)
  firstOpenedAt           DateTime?
  lastOpenedAt            DateTime?
  // POS checkout — only set on PAYMENT rows recorded at a till.
  paymentMethod           String? // "cash" | "card" | provider id, e.g. "yoco"
  tillSessionId           String?
  tillSession             TillSession?      @relation(fields: [tillSessionId], references: [id])
  // Overrides the default follow-up cadence when an inbound email reply
  // gave a real scheduling cue ("call me back in 2 weeks") — the
  // follow-up cron checks this before falling back to
  // Tenant.followUpWindowDays/followUpRepeatDays.
  nextFollowUpAt          DateTime?
  // Owner-set context for a manual reminder ("said he'll be ready in 2
  // months") — shown next to the quote and on the This Week board so the
  // reminder isn't just a bare date with no memory of why.
  followUpNote            String?
  // Google Calendar event id for this reminder, if the tenant has
  // connected a calendar — lets setManualReminder update the existing
  // event instead of creating a duplicate, and clearManualReminder
  // delete it instead of leaving an orphaned calendar entry.
  calendarEventId         String?

  itemLines        TransactionLine[]
  paymentCheckouts PaymentCheckout[]
  ecommerceOrder   EcommerceOrder?
  jobCards         JobCard[]

  obligations Obligation[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type, status])
  @@map("transactions")
}

model TransactionLine {
  id              String      @id @default(cuid())
  transactionId   String
  transaction     Transaction @relation(fields: [transactionId], references: [id])
  itemId          String
  item            Item        @relation(fields: [itemId], references: [id])
  quantity        Int
  unitPriceCents  Int
  // Snapshotted at the time this line was added, not read live off Item —
  // so a later change to the catalog's tax rate never silently rewrites
  // the tax on a quote/invoice that already went out.
  discountPercent Float?      @default(0)
  taxRatePercent  Float?

  @@index([transactionId])
  @@map("transaction_lines")
}

// Movement: deliveries, site visits, installs, stock transfers, follow-ups sent.
model Event {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  partyId       String?
  party         Party?    @relation(fields: [partyId], references: [id])
  transactionId String? // which quote/invoice this event relates to, e.g. a FOLLOW_UP_SENT
  type          EventType
  notes         String?
  photoUrl      String?
  signedByUrl   String?
  gpsLat        Float?
  gpsLng        Float?
  scheduledAt   DateTime? // when this is a booked appointment (CONSULTATION/SITE_VISIT), the slot time — null for events logged after the fact
  // Marked by a human after the fact — the PA can't infer a no-show on its
  // own (a passed appointment with no linked invoice is just as often
  // "hasn't billed yet"), so this stays a deliberate action that then
  // triggers the automatic rebooking nudge (src/lib/core/reminders.ts).
  noShow        Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([tenantId])
  @@index([transactionId])
  @@index([tenantId, scheduledAt])
  @@map("events")
}

// Cross-tenant connection: lets a WHOLESALE-niche tenant and a RETAIL-niche
// (or any) tenant trade directly inside the app, per the strategic report's
// Section 11 — the wholesaler-retailer network layer. Orders placed across
// a connection still just create ordinary Transaction rows on each side;
// this model only tracks who's allowed to trade with whom and on what terms.
model WholesaleConnection {
  id               String           @id @default(cuid())
  supplierTenantId String
  supplierTenant   Tenant           @relation("SupplierConnections", fields: [supplierTenantId], references: [id])
  buyerTenantId    String
  buyerTenant      Tenant           @relation("BuyerConnections", fields: [buyerTenantId], references: [id])
  status           ConnectionStatus @default(PENDING)
  // Optional discount off the supplier's standard item price for this buyer —
  // the tiered/contract pricing requirement from the strategic report's
  // wholesale section, kept simple (a flat percentage) rather than
  // per-item tiers, which is a natural Phase 9 extension once real
  // wholesale customers ask for it.
  discountPercent  Float?
  // Null = no limit enforced. Checked against the buyer's outstanding
  // balance on the supplier's books before a new connected order is
  // accepted — the credit-risk gap identified in the wholesale pain-point
  // research (orders placed with no visibility into buyer credit exposure).
  creditLimitCents Int?
  createdAt        DateTime         @default(now())

  @@unique([supplierTenantId, buyerTenantId])
  @@index([supplierTenantId])
  @@index([buyerTenantId])
  @@map("wholesale_connections")
}

// Phase 8 hardening: every mutating action through the Business Graph API
// leaves a trace here — who (actor), what (capability), on what (target),
// and when. This is the audit trail that makes AI-taken actions reviewable,
// per the trust/reversibility principle in the strategic report (6.4).
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  actorType  String // "user" | "ai" | "system"
  actorId    String? // User.id when actorType is "user"
  capability String // e.g. "quote:create"
  targetType String // e.g. "Transaction"
  targetId   String
  metadata   String? // small JSON blob, kept as text to avoid a Json-type dependency
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// Team task/project management — deliberately simple (one flat list, three
// states) rather than a full project-management suite, per the "must be
// easy to use" instruction. Real workflow automation happens through the
// AI/follow-up engine (src/lib/ai, src/app/api/cron), not a visual
// rule-builder here — consistent with the platform's AI-first stance
// against Zapier-style no-code builders that still require developer-style
// thinking to configure.
model Task {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  title       String
  description String?
  status      TaskStatus @default(TODO)
  assigneeId  String? // Membership.id — assigned to a specific person's role on this tenant
  partyId     String? // optional link to the customer/deal this task is about
  dueAt       DateTime?
  createdAt   DateTime   @default(now())

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("tasks")
}

// Reusable proposal starter text — pick one when building a PROPOSAL-kind
// quote instead of retyping the intro/scope every time. Deliberately just
// two text blocks, matching what QuoteKind.PROPOSAL actually renders.
model ProposalTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  introText   String?
  scopeOfWork String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("proposal_templates")
}

// Internal team comments on any record — a customer, a quote, a task —
// polymorphic by (entityType, entityId) rather than a table per entity,
// since the shape (who said what, when) never varies. @mentions are
// stored as plain text (@Name) and rendered highlighted; no push
// notification wiring yet, just visible to anyone viewing the record.
model Comment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  entityType String // "Party" | "Transaction" | "Task"
  entityId   String
  authorId   String // Membership.id
  body       String
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("comments")
}

// Public API access — the piece that unlocks Zapier and any other
// external integration without needing a partnership with anyone. Keys
// act with full read/write on their own tenant; only the hash is stored,
// the plaintext key is shown exactly once at creation.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  name       String
  keyPrefix  String    @unique // shown in the list so a key is identifiable without re-revealing it
  keyHash    String    @unique
  // A key carries a Role rather than its own permission list. The app already
  // has one permission model (Role -> Capability, lib/core/access.ts) and
  // every core function is written against it; a second, parallel scheme for
  // API callers would be two things to keep in step, and the one that drifts
  // is always the one nobody is looking at.
  role       String    @default("STAFF") // OWNER | STAFF | DRIVER | REP | TECHNICIAN, as on Membership
  // May read whatever its role can see, and write nothing. The common case
  // for dashboards, exports, and anything that runs in a browser.
  readOnly   Boolean   @default(false)
  expiresAt  DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  // Fixed-window rate limiting, counted on the row. In-memory counters are
  // per-instance and therefore meaningless once this runs on more than one
  // machine; one extra write per request is the honest price of a limit that
  // actually holds.
  windowStart DateTime @default(now())
  windowCount Int      @default(0)

  @@index([tenantId])
  @@map("api_keys")
}

// Outbound event notifications — the other half of "integrate with
// anything." Delivered with an HMAC-SHA256 signature (X-Flow-Signature
// header) so the receiver can verify authenticity.
model WebhookEndpoint {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  url       String
  secret    String
  events    String[] // e.g. ["quote.created", "quote.accepted", "invoice.paid", "dispute.raised"]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String          @id @default(cuid())
  endpointId  String
  endpoint    WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event       String
  payload     Json            @default("{}")
  statusCode  Int?
  error       String?
  // Retry bookkeeping. A delivery that never lands has to stay visible rather
  // than being dropped — "we sent it" is a claim someone eventually checks.
  attempts    Int             @default(0)
  status      String          @default("PENDING") // PENDING | DELIVERED | FAILED
  nextAttempt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime        @default(now())

  @@index([endpointId])
  @@index([status, nextAttempt])
  @@map("webhook_deliveries")
}

enum CollectionsTone {
  GENTLE
  STANDARD
  FIRM
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

// A real path for "this isn't right" — most CRMs have zero structured way
// to handle pushback, which is exactly where trust is won or lost. Raised
// by the customer from the portal, resolved by the owner from the
// dashboard, tracked start to finish instead of living in a WhatsApp thread.
model Dispute {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  transactionId  String
  partyId        String
  party          Party         @relation(fields: [partyId], references: [id])
  message        String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?

  @@index([tenantId, status])
  @@index([transactionId])
  @@map("disputes")
}

enum AiDraftStatus {
  PENDING
  SENT
  SKIPPED
}

// The confirm-before-send guardrail, made real: every AI-drafted
// customer-facing message lands here first, with the reasoning behind its
// tone visible, instead of being sent straight from the cron job. Nothing
// leaves without a human clicking Approve (or Skip).
model AiDraft {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  partyId       String
  party         Party         @relation(fields: [partyId], references: [id])
  transactionId String
  touchNumber   Int
  body          String
  reasoning     String // one line: why this tone/timing was chosen
  status        AiDraftStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  resolvedAt    DateTime?

  @@index([tenantId, status])
  @@map("ai_drafts")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
}

// A standing instruction to auto-generate + send an invoice on a schedule
// — line items are a snapshot (not live catalog references) so editing a
// product later doesn't silently change a subscription's price. The cron
// route is the only writer of nextRunAt; everything else just reads it.
model RecurringInvoice {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  partyId   String
  party     Party               @relation(fields: [partyId], references: [id])
  frequency RecurrenceFrequency
  dueInDays Int                 @default(14)
  isActive  Boolean             @default(true)
  lines     Json // snapshot: [{ itemId, name, quantity, unitPriceCents }]
  nextRunAt DateTime
  lastRunAt DateTime?
  createdAt DateTime            @default(now())

  @@index([tenantId])
  @@index([isActive, nextRunAt])
  @@map("recurring_invoices")
}

// The flow/Skynat marketing site itself (not a tenant's business) —
// platform-global, editable only by super-admins via /admin. One row per
// page (keyed by slug), each with an ordered list of sections. Section
// shape is deliberately generic (heading/body/image/items) rather than a
// free block builder — src/lib/cms/pageTemplates.ts is the single source
// of truth for which sections exist on which page and how each renders.
model PageContent {
  id              String   @id @default(cuid())
  slug            String   @unique // "home", "about", "ai-agents", "industry-SERVICES", ...
  title           String
  metaDescription String?
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  sections PageSection[]

  @@map("page_contents")
}

model PageSection {
  id         String      @id @default(cuid())
  pageId     String
  page       PageContent @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key        String // matches the slot key in pageTemplates.ts, e.g. "hero", "benefits_grid"
  heading    String?
  subheading String?
  body       String?
  imageUrl   String?
  ctaLabel   String?
  ctaHref    String?
  // Repeatable sub-items for grid/testimonials/logos/cards sections:
  // [{ title, body, imageUrl, href, name, role }, ...] — shape varies by
  // section type, interpreted by SectionRenderer per pageTemplates.ts.
  items      Json?
  order      Int         @default(0)

  @@unique([pageId, key])
  @@map("page_sections")
}

model Note {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  entityType String // "Party" | "Transaction" | "Task" | "Tenant" (general note)
  entityId   String?
  authorId   String // Membership.id
  title      String?
  body       String
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId])
  @@map("notes")
}

enum GoalStatus {
  ON_TRACK
  AT_RISK
  ACHIEVED
  MISSED
}

model Goal {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  ownerId      String? // Membership.id — null = whole-company goal
  title        String
  metricLabel  String // e.g. "Revenue", "New customers"
  targetValue  Float
  currentValue Float      @default(0)
  dueDate      DateTime?
  status       GoalStatus @default(ON_TRACK)
  createdAt    DateTime   @default(now())

  @@index([tenantId])
  @@map("goals")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Expense {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  submittedById   String // Membership.id
  category        String?
  descriptionText String
  amountCents     Int
  receiptDataUrl  String? // optional attached slip — same base64 pattern as e-signatures
  status          ExpenseStatus @default(PENDING)
  // Money the owner took out of the business for themselves, rather than a
  // cost of running it. They come off the same card and look identical on a
  // statement, which is why most small businesses cannot say what their real
  // costs are — and why drawings booked as expenses make a profitable
  // business look like it is barely breaking even.
  //
  // Null is a real third state: nobody has said yet. It is what the agent
  // asks about, and collapsing it into false would hide every unreviewed row.
  isOwnerDrawing  Boolean?
  approvedById    String?
  createdAt       DateTime      @default(now())

  @@index([tenantId, status])
  @@map("expenses")
}

// A Thread is either a DM (two participantIds), a named group, or scoped
// to a Task (job card). Polling-based reads for v1 — no websocket infra
// in this stack yet, and the rest of the dashboard already works this way
// (server components + revalidatePath), so this stays consistent with it.
model MessageThread {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String? // set for group threads, null for a DM
  taskId         String? // optional: scoped to a job card/project task
  participantIds String[] // Membership.id[]
  createdAt      DateTime @default(now())

  messages Message[]

  @@index([tenantId])
  @@map("message_threads")
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id])
  authorId  String // Membership.id
  body      String
  createdAt DateTime      @default(now())

  @@index([threadId, createdAt])
  @@map("messages")
}

model TimeEntry {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  membershipId String // who clocked in
  clockInAt    DateTime  @default(now())
  clockOutAt   DateTime?
  notes        String?

  @@index([tenantId, membershipId])
  @@map("time_entries")
}

model FuelLog {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  driverId   String // Membership.id
  odometerKm Int?
  litres     Float
  costCents  Int
  loggedAt   DateTime @default(now())
  notes      String?

  @@index([tenantId, driverId])
  @@map("fuel_logs")
}

// Expected vs counted stock, per count — the retail shrinkage-variance
// research finding, made visible instead of only discovered months later.
model Stocktake {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  expectedQty Int
  countedQty  Int
  countedById String // Membership.id
  createdAt   DateTime @default(now())

  @@index([tenantId, itemId])
  @@map("stocktakes")
}

enum ClaimStatus {
  SUBMITTED
  PAID
  DENIED
  REWORKED
}

// Structured insurance-claim tracking — not a real payer/insurance API
// integration, just the difference between "a denied claim quietly aged
// into a write-off" (the research finding) and one that's visibly tracked
// until it's resolved.
model InsuranceClaim {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  transactionId String // the invoice this claim is for
  payerName     String
  claimedCents  Int
  status        ClaimStatus @default(SUBMITTED)
  denialReason  String?
  submittedAt   DateTime    @default(now())
  resolvedAt    DateTime?

  @@index([tenantId, status])
  @@map("insurance_claims")
}

// ---------------------------------------------------------------------
// POS — own built-in checkout plus region-scaffolded card-provider
// integrations (RSA/Yoco first). A TillSession brackets a cash-drawer
// session (open float -> sales -> close/count), same reconciliation
// philosophy as Stocktake: expected vs counted, variance surfaced instead
// of silently absorbed.
// ---------------------------------------------------------------------

model TillSession {
  id                  String    @id @default(cuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  openedById          String // Membership.id
  openingFloatCents   Int
  openedAt            DateTime  @default(now())
  closedById          String?
  closingCountedCents Int?
  // Persisted at close time so the mismatch flag survives past the single
  // request that closed the till — see closeTill() in src/lib/core/pos.ts.
  // Positive = counted more cash than expected, negative = a shortfall.
  varianceCents       Int?
  closedAt            DateTime?

  payments Transaction[]

  @@index([tenantId])
  @@map("till_sessions")
}

enum PosProviderType {
  YOCO
  IKHOKHA
  SQUARE
  ZELLER
  GENERIC
}

// Scaffolded per-region so adding a new market is one new provider file,
// not a schema change — region is stored alongside provider so the
// settings UI can filter the picker to what's relevant for that tenant.
model PosIntegration {
  id        String          @id @default(cuid())
  tenantId  String
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  provider  PosProviderType
  region    String // "RSA" | "USA" | "AU" | "EU"
  apiKey    String? // opaque; stubbed (logs instead of charging) until set
  isActive  Boolean         @default(false)
  createdAt DateTime        @default(now())

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("pos_integrations")
}

// Online card payments — lets a CUSTOMER pay a quote/invoice from the
// portal by card, distinct from PosIntegration (which is the merchant's
// own in-person till). One tenant can enable several; whichever is
// isActive and matches the tenant's region is offered on the portal.
enum PaymentGatewayProvider {
  // RSA
  YOCO
  PAYFAST
  PEACH_PAYMENTS
  OZOW
  IKHOKHA
  SNAPSCAN
  PAYSTACK
  NETCASH
  // USA
  STRIPE
  PAYPAL
  SQUARE
  AUTHORIZE_NET
  BRAINTREE
}

model PaymentGateway {
  id            String                 @id @default(cuid())
  tenantId      String
  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  provider      PaymentGatewayProvider
  region        String // "RSA" | "USA"
  publicKey     String? // safe to expose client-side (Stripe publishable key, PayFast merchant id, etc.)
  secretKey     String? // opaque; stubbed (returns a fake success) until set
  // Signing secret for the provider's server-to-server callback: Stripe's
  // whsec_..., PayFast's passphrase, Paystack/Yoco's webhook secret. A
  // payment is only written to the ledger when a callback signed with this
  // verifies — a customer landing back on the return URL proves nothing.
  webhookSecret String?
  isActive      Boolean                @default(false)
  createdAt     DateTime               @default(now())

  @@unique([tenantId, provider])
  @@index([tenantId])
  @@map("payment_gateways")
}

// A customer-initiated card payment attempt, tracked separately from the
// Transaction ledger until the gateway confirms it — only a confirmed
// checkout is allowed to call recordPayment and write a real PAYMENT row,
// so a customer closing the tab mid-checkout never corrupts the ledger.
model PaymentCheckout {
  id             String                 @id @default(cuid())
  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  invoiceId      String
  invoice        Transaction            @relation(fields: [invoiceId], references: [id])
  provider       PaymentGatewayProvider
  amountCents    Int
  reference      String? // gateway's checkout/session id
  status         String                 @default("PENDING") // PENDING | CONFIRMED | FAILED
  createdAt      DateTime               @default(now())
  confirmedAt    DateTime?
  // Set when a verified webhook confirmed this checkout, and by which
  // provider event. Null on a CONFIRMED row means it was confirmed some
  // other way, which should never happen now and is worth auditing.
  webhookEventId String?                @unique
  failureReason  String?

  @@index([tenantId])
  @@index([invoiceId])
  @@index([reference])
  @@map("payment_checkouts")
}

// Storefront sync — WordPress/WooCommerce today, scaffolded per platform
// like PosIntegration/PaymentGateway so Shopify/BigCommerce are one new
// enum value + one new client file later, not a schema change.
enum EcommercePlatform {
  WOOCOMMERCE
}

model EcommerceIntegration {
  id                String            @id @default(cuid())
  tenantId          String
  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  platform          EcommercePlatform
  storeUrl          String // e.g. https://shop.example.com
  consumerKey       String? // WooCommerce REST API key (ck_...)
  consumerSecretEnc String? // AES-256-GCM encrypted (WooCommerce cs_... secret)
  webhookSecretEnc  String? // AES-256-GCM encrypted — verifies WooCommerce's X-WC-Webhook-Signature
  isActive          Boolean           @default(false)
  lastProductSyncAt DateTime?
  createdAt         DateTime          @default(now())

  orders EcommerceOrder[]

  @@unique([tenantId, platform])
  @@index([tenantId])
  @@map("ecommerce_integrations")
}

// One row per external order already turned into a flow invoice — the
// idempotency guard so a WooCommerce webhook retry (it retries on
// anything but a 200) never creates a duplicate invoice for the same order.
model EcommerceOrder {
  id              String               @id @default(cuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  integrationId   String
  integration     EcommerceIntegration @relation(fields: [integrationId], references: [id])
  externalOrderId String // WooCommerce order id, as a string
  invoiceId       String?              @unique
  invoice         Transaction?         @relation(fields: [invoiceId], references: [id])
  createdAt       DateTime             @default(now())

  @@unique([integrationId, externalOrderId])
  @@index([tenantId])
  @@map("ecommerce_orders")
}

// ---------------------------------------------------------------------
// Non-profit / faith organization niche — membership, donations, and
// compliance-filing history, built append-only so "prove I was involved,
// from when to when" is always answerable later (the real gap that
// prompted this module: churches/NPOs losing exactly this kind of record).
// ---------------------------------------------------------------------

enum InvolvementRole {
  MEMBER
  VOLUNTEER
  BOARD
  STAFF
  SPONSOR
}

// A person's involvement is tracked as a history of roles over time rather
// than a single current status — closing (setting endDate) never deletes
// the row, so a past involvement is provable years later.
model MembershipInvolvement {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  partyId      String
  party        Party           @relation(fields: [partyId], references: [id])
  role         InvolvementRole
  startDate    DateTime
  endDate      DateTime?
  // When set, this membership/sponsorship is due for renewal on this date
  // — the PA job "chase a lapsing membership the same way a quote gets
  // chased" (src/lib/core/nonprofit.ts checkMembershipRenewals) reads
  // this instead of assuming an annual cadence, since renewal terms
  // genuinely vary member to member.
  renewalDueAt DateTime?
  notes        String?
  createdAt    DateTime        @default(now())

  @@index([tenantId, partyId])
  @@map("membership_involvements")
}

// A real ledger, kept separate from the commercial Transaction model —
// a donation isn't a sale (no line items, no VAT), it's a gift toward a
// designated fund/purpose, and needs its own receipt/certificate trail.
model Donation {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  partyId        String
  party          Party    @relation(fields: [partyId], references: [id])
  amountCents    Int
  designatedFund String? // e.g. "Building Fund", "General", null = unrestricted
  receiptNumber  String?
  donatedAt      DateTime @default(now())

  @@index([tenantId, donatedAt])
  @@map("donations")
}

// Structured record of the exact kind of document whose absence caused
// the user's real problem — annual returns, PBO/tax-exempt filings, AGM
// minutes. documentDataUrl reuses the same base64 attachment pattern as
// e-signatures/photos elsewhere, no object storage dependency.
model ComplianceFiling {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  filingType      String // "Annual Return" | "PBO Renewal" | "AGM Minutes" | ...
  filingDate      DateTime
  documentDataUrl String?
  notes           String?
  createdAt       DateTime @default(now())

  @@index([tenantId, filingType])
  @@map("compliance_filings")
}

// ---------------------------------------------------------------------
// Obligations — the dated things this business owes somebody else, and
// what it costs to miss them.
//
// One engine rather than seven registers. A CIPC annual return, a liquor
// licence, a driver's PDP, an insurance policy, the notice window on a
// supplier contract and a warranty on something we sold are all the same
// shape: something falls due on a date, some of them repeat, each has a
// consequence, and a few of them should physically stop work happening
// when they lapse. Modelled once, the agent watches all of them with one
// piece of logic and a new category is a row instead of a table.
//
// Distinct from ComplianceFiling above, deliberately: that records what
// was filed, this records what is owed. Completing an obligation of kind
// COMPLIANCE_FILING writes a ComplianceFiling row, so the log keeps
// working exactly as it did.
// ---------------------------------------------------------------------

enum ObligationKind {
  COMPLIANCE_FILING // CIPC annual return, COIDA return, AGM minutes
  LICENCE // trading, liquor, health, professional body registration
  CERTIFICATE // tax clearance, BEE affidavit, letter of good standing
  TAX // VAT201, EMP201, IRP6
  INSURANCE // policy renewal
  CONTRACT // customer or supplier agreement with a notice window
  WARRANTY // what we sold, and how long it stays our problem
  DOCUMENT // a person's or an asset's document: PDP, work permit, roadworthy
}

enum ObligationRecurrence {
  NONE
  MONTHLY
  BIMONTHLY // SARS VAT201 for most small vendors
  QUARTERLY
  BIANNUAL // IRP6 provisional tax
  ANNUAL
}

// How bad it is to miss this. Drives ordering, how early the agent starts
// warning, and whether it is allowed to stay quiet about it.
enum ObligationSeverity {
  CRITICAL // the company stops existing, or stops being allowed to trade
  HIGH // locked out of tenders, sites or customers
  MEDIUM // penalty, interest or a fine
  LOW // administrative tidiness
}

enum ObligationStatus {
  OPEN
  DONE
  WAIVED // consciously decided not to do — kept, not deleted, so "why isn't this on the list" stays answerable
}

model Obligation {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  kind        ObligationKind
  title       String
  authority   String? // who wants it: CIPC, SARS, the Department of Employment and Labour, an insurer, a supplier
  reference   String? // registration, policy or certificate number
  dueAt       DateTime
  recurrence  ObligationRecurrence @default(NONE)
  severity    ObligationSeverity   @default(MEDIUM)
  status      ObligationStatus     @default(OPEN)
  // How many days before dueAt this stops being background and becomes
  // work. Seeded per kind — a CIPC return needs a month of warning, a
  // vehicle licence disc needs a week.
  leadDays    Int                  @default(30)
  // Plain sentence naming what actually happens if this lapses. Stored
  // rather than derived because it is the single most useful thing on the
  // record and it differs per business — the agent quotes it verbatim
  // instead of inventing a reason the thing matters.
  consequence String?

  // Contract-specific. noticeDays is the window before dueAt in which
  // notice has to be given, which is the date that actually matters on an
  // auto-renewing agreement — miss it and you have renewed by silence.
  noticeDays Int?
  autoRenews Boolean @default(false)

  // When true, this lapsing is not advice. Work that depends on the
  // subject is refused rather than warned about — an expired PDP means
  // that driver does not get dispatched.
  blocksWork Boolean @default(false)

  // The library row this came from, when it came from one. Lets a correction
  // made here be offered back to the library, and lets us stop suggesting a
  // template this business has already dismissed.
  templateId String?

  // What the obligation is about, when it is about something. All
  // optional and all real foreign keys rather than a loose type/id pair,
  // so "show me everything expiring on this vehicle" is a query and not a
  // string comparison.
  partyId       String?
  party         Party?       @relation(fields: [partyId], references: [id])
  membershipId  String?
  membership    Membership?  @relation(fields: [membershipId], references: [id])
  itemId        String?
  item          Item?        @relation(fields: [itemId], references: [id])
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  completedAt       DateTime?
  documentDataUrl   String? // proof, same base64 pattern as e-signatures and receipts
  notes             String?
  // What the owner was last told about this, and when. The compliance watch
  // runs on every tick, so without this it would re-raise the same lapsed
  // licence every fifteen minutes and be muted within a day. Notifications
  // fire on a change of state, not on the state itself.
  lastNotifiedState String?
  lastNotifiedAt    DateTime?

  // Set when this row was created by advancing a recurring obligation,
  // so a history of "we have done this every year" is reconstructable.
  previousId String?
  createdAt  DateTime @default(now())

  @@index([tenantId, status, dueAt])
  @@index([tenantId, kind])
  @@index([tenantId, blocksWork, status])
  @@map("obligations")
}

// ---------------------------------------------------------------------
// The obligation library — shared across every workspace, owned by none.
//
// This is the part that stops compliance being a South African feature. No
// obligation title, authority or deadline is written in code: they are rows
// here, keyed by country and region. A workspace in Ohio and a workspace in
// Gauteng run the identical code path and get entirely different calendars,
// because the difference lives in data.
//
// Rows arrive three ways, and all three matter:
//
//   CURATED  - seeded for the markets we already serve.
//   DOCUMENT - extracted from a document a real business uploaded. Their
//              licence tells us what that licence is called in their country
//              far more reliably than any list we could write.
//   RESEARCH - the model filling in a jurisdiction nobody has covered yet,
//              the first time a business from there signs up.
//
// The counters are the quality signal. A template many businesses kept is
// more trustworthy than one everybody dismissed, and that ordering is what
// keeps a bad guess from propagating to the next user from that country.
// ---------------------------------------------------------------------

enum ObligationTemplateSource {
  CURATED
  DOCUMENT // learned from a document a business uploaded
  RESEARCH // researched for a jurisdiction on first use
  USER // typed in by a business, offered onward
}

model ObligationTemplate {
  id          String                   @id @default(cuid())
  countryCode String // ISO 3166-1 alpha-2
  regionCode  String? // null = applies across the whole country
  title       String
  authority   String?
  kind        ObligationKind
  recurrence  ObligationRecurrence     @default(ANNUAL)
  severity    ObligationSeverity       @default(MEDIUM)
  leadDays    Int                      @default(30)
  consequence String?
  noticeDays  Int?
  blocksWork  Boolean                  @default(false)
  source      ObligationTemplateSource @default(RESEARCH)

  // When in the year it usually falls. Null where it depends on the
  // business's own dates (an incorporation anniversary, a policy renewal)
  // rather than on a fixed national deadline.
  dueMonth                    Int?
  dueDay                      Int?
  // Set when the date follows the business's own registration anniversary
  // rather than a fixed calendar date.
  fromRegistrationAnniversary Boolean @default(false)

  // Which businesses this applies to. Null means "does not depend on it",
  // which is different from false — an obligation that applies whether or
  // not you employ people must not be filtered out of an employer's list.
  requiresCompany   Boolean?
  requiresVat       Boolean?
  requiresEmployees Boolean?
  requiresVehicles  Boolean?

  // Trust signals, not analytics: these order what gets offered first and
  // retire templates nobody accepts.
  adoptedCount   Int @default(0)
  confirmedCount Int @default(0)
  dismissedCount Int @default(0)

  // Provenance for our own debugging. Never shown to another workspace —
  // a business's compliance profile is not something to leak sideways.
  contributedByTenantId String?
  sourceNote            String?
  createdAt             DateTime @default(now())

  @@unique([countryCode, regionCode, title])
  @@index([countryCode, regionCode])
  @@map("obligation_templates")
}

// Records that a jurisdiction has been looked at, so the research pass runs
// once per country rather than once per signup — and so a country with
// genuinely nothing found is not re-researched on every visit.
model JurisdictionCoverage {
  id            String    @id @default(cuid())
  countryCode   String
  regionCode    String?
  templateCount Int       @default(0)
  researchedAt  DateTime?
  /**
   * Why coverage is thin, when it is. Shown to the user rather than hidden.
   */
  note          String?
  updatedAt     DateTime  @updatedAt

  @@unique([countryCode, regionCode])
  @@map("jurisdiction_coverage")
}

// ---------------------------------------------------------------------
// Rentals — platform-wide, not tied to one niche. Any Item can be marked
// rentable instead of (or as well as) sellable; a Rental tracks the
// out/returned lifecycle a straight sale doesn't need.
// ---------------------------------------------------------------------

enum RentalRateUnit {
  HOUR
  DAY
  WEEK
  MONTH
}

enum RentalStatus {
  ACTIVE
  RETURNED
  OVERDUE
}

model Rental {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  itemId        String
  item          Item           @relation(fields: [itemId], references: [id])
  partyId       String
  party         Party          @relation(fields: [partyId], references: [id])
  startAt       DateTime       @default(now())
  endAt         DateTime? // expected return — null = open-ended
  returnedAt    DateTime?
  rateCents     Int
  rateUnit      RentalRateUnit
  depositCents  Int?
  status        RentalStatus   @default(ACTIVE)
  transactionId String? // the invoice covering this rental, once billed

  @@index([tenantId, status])
  @@map("rentals")
}

// ---------------------------------------------------------------------
// Property sales, leasing & management — its own domain: a Property is
// the asset, a Lease is a specific tenancy on it. Reuses Event (with a
// new PROPERTY_INSPECTION type) for inspections/maintenance visits rather
// than a parallel model, consistent with how Event already generalizes
// site visits/deliveries/installs.
// ---------------------------------------------------------------------

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  LAND
}

enum PropertyStatus {
  AVAILABLE
  LEASED
  SOLD
  MAINTENANCE
}

model Property {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  address           String
  propertyType      PropertyType
  ownerPartyId      String? // set when managing on behalf of an owner, not the agency's own stock
  status            PropertyStatus @default(AVAILABLE)
  listingPriceCents Int? // for sale
  rentalRateCents   Int? // for lease, per month
  createdAt         DateTime       @default(now())

  leases Lease[]

  @@index([tenantId, status])
  @@map("properties")
}

enum LeaseStatus {
  ACTIVE
  ENDED
  TERMINATED
}

model Lease {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  propertyId       String
  property         Property    @relation(fields: [propertyId], references: [id])
  renterPartyId    String
  renterParty      Party       @relation(fields: [renterPartyId], references: [id])
  startDate        DateTime
  endDate          DateTime?
  monthlyRentCents Int
  depositCents     Int?
  status           LeaseStatus @default(ACTIVE)
  documentDataUrl  String? // the signed lease contract
  createdAt        DateTime    @default(now())

  @@index([tenantId, status])
  @@index([propertyId])
  @@map("leases")
}

// ---------------------------------------------------------------------
// PDF templates — styleKey references a fixed design config in
// src/lib/pdf/styles.ts, not a DB-editable layout (so "10+ templates"
// means 10 real, tested layouts, not a page-builder). A tenant can own
// several of these (recommended: one default + up to 2 customized), pick
// which style each is based on, and override its accent color/logo.
// ---------------------------------------------------------------------

model TenantPdfTemplate {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  name             String
  styleKey         String // one of the keys in PDF_STYLES
  isDefault        Boolean  @default(false)
  accentColorHex   String?
  logoDataUrl      String?
  // Per-field overrides on top of the base style (styleKey) — the real
  // "customize each part" controls: font, header layout, table header
  // style, logo shape. Null = inherit whatever the base style says, so
  // picking a style and never touching these still renders exactly like
  // that style always has.
  fontFamily       String? // "Helvetica" | "Times-Roman" | "Courier"
  headerLayout     String? // "centered" | "split" | "band"
  tableHeaderStyle String? // "dark" | "accent" | "line-only"
  logoShape        String? // "circle" | "square" | "none"
  // Superseded by `sections` below. Kept so templates saved before the
  // section builder existed still resolve; nothing writes them any more.
  sectionOrder     Json?
  hiddenSections   Json?
  // The section-by-section layout: an ordered array of
  // { key, visible, title, body, align, fields } — see lib/pdf/sections.ts.
  // Null means "the catalogue defaults", so a template nobody has edited
  // renders the standard document.
  sections         Json?
  // Colour beyond the accent. Null inherits the base style, so picking a
  // style and touching nothing renders exactly as that style always has.
  textColorHex     String?
  mutedColorHex    String?
  // Typography and page setup.
  fontScale        Float? // 0.85 - 1.25, multiplies every size
  pageSize         String? // "A5" | "A4" | "LETTER"
  orientation      String? // "portrait" | "landscape"
  // Coarse preset, set by the design presets. Superseded per-edge by the
  // four values below whenever the owner sets them explicitly.
  pageMargin       String? // "compact" | "normal" | "roomy"
  marginTopIn      Float?
  marginBottomIn   Float?
  marginLeftIn     Float?
  marginRightIn    Float?
  // Page background. Null = white, which is what a printed document wants
  // unless somebody deliberately decides otherwise.
  backgroundHex    String?
  // Which documents this template renders. A workspace usually wants a
  // different look for a delivery slip than for a proposal, which one
  // workspace-wide default could never express.
  appliesTo        String   @default("ALL") // ALL | QUOTE | INVOICE | SLIP
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@map("tenant_pdf_templates")
}

// ---------------------------------------------------------------------
// Built-in mail client — a BlueMail-style unified inbox. GOOGLE is a
// coming-soon connection type (needs a real OAuth app registered and
// verified with Google before it can do anything beyond sit disabled,
// same checkpoint class as Google Drive backup). IMAP is real today —
// the owner's own mail credentials, encrypted at rest (src/lib/crypto.ts)
// since this is meaningfully more sensitive than an API key. FLOW_HOSTED
// is a forwarding address unique to this tenant that flow ingests via
// webhook — no credentials to store at all.
// ---------------------------------------------------------------------

enum EmailProviderType {
  GOOGLE
  IMAP
  FLOW_HOSTED
}

model EmailAccount {
  id                 String            @id @default(cuid())
  tenantId           String
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  provider           EmailProviderType
  emailAddress       String
  imapHost           String?
  imapPort           Int?
  imapUser           String?
  imapPasswordEnc    String? // AES-encrypted, never plaintext
  flowInboundAddress String?           @unique // e.g. "acme-co@mail.flow.skynat.co"
  isActive           Boolean           @default(true)
  lastCheckedAt      DateTime?
  createdAt          DateTime          @default(now())

  emails InboundEmail[]

  @@index([tenantId])
  @@map("email_accounts")
}

enum EmailCategory {
  STATEMENT
  INVOICE
  LEGAL
  QUOTE_REPLY
  PAYMENT_REPLY
  OTHER
}

// Every inbound message that's been ingested (IMAP poll or webhook),
// classified by AI so statements/invoices/legal mail surfaces as
// important in the dashboard instead of getting buried in an inbox
// nobody checks — the actual problem this feature exists to solve.
model InboundEmail {
  id                    String        @id @default(cuid())
  tenantId              String
  tenant                Tenant        @relation(fields: [tenantId], references: [id])
  emailAccountId        String
  emailAccount          EmailAccount  @relation(fields: [emailAccountId], references: [id])
  fromAddress           String
  subject               String
  bodyText              String
  receivedAt            DateTime
  category              EmailCategory @default(OTHER)
  isImportant           Boolean       @default(false)
  looksLikePaymentProof Boolean       @default(false)
  aiSummary             String?
  // If the AI reads a scheduling cue in a quote reply ("call me back in
  // 2 weeks"), it links back to the quote and the follow-up cron reads
  // Transaction.nextFollowUpAt instead of the default cadence.
  linkedTransactionId   String?
  isRead                Boolean       @default(false)
  createdAt             DateTime      @default(now())

  @@index([tenantId, isRead])
  @@index([tenantId, category])
  @@map("inbound_emails")
}

enum NotificationType {
  HOT_LEAD
  IMPORTANT_EMAIL
  AUTO_FOLLOW_UP_SENT
  FOLLOW_UP_NEEDS_APPROVAL
  PAYMENT_PROOF_RECEIVED
  GENERAL
}

// One shared in-dashboard notification center — also the hub other
// channels (WhatsApp alert to the assigned salesperson today, push once
// there's a mobile push provider) fan out from, so there's a single
// record of "the business was told about this," not a different history
// per channel.
model Notification {
  id              String           @id @default(cuid())
  tenantId        String
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  membershipId    String? // null = visible to every member of the tenant
  type            NotificationType
  title           String
  body            String
  linkHref        String?
  isRead          Boolean          @default(false)
  sentViaWhatsApp Boolean          @default(false)
  createdAt       DateTime         @default(now())

  @@index([tenantId, isRead])
  @@index([tenantId, membershipId, isRead])
  @@map("notifications")
}

// Platform-wide (not per-tenant) settings a super-admin controls — today
// just which LLM provider powers every AI feature (proposals, email
// classification, follow-up drafting, onboarding extraction). A single
// fixed-id row rather than a real table, since there's exactly one of
// these per deployment; getAiModel() reads it so a provider switch takes
// effect immediately, no redeploy needed.
model PlatformSetting {
  id            String   @id @default("singleton")
  aiProvider    String   @default("anthropic") // "anthropic" | "google"
  // Which engine renders spoken voice (daily briefing, PA answers) when a
  // tenant's own character allowance for the period hasn't run out —
  // "browser" costs nothing and needs no key (client-side Web Speech API);
  // "google" is the paid Neural2 upgrade, only actually used once a
  // GOOGLE_TTS_API_KEY is configured. Safe to flip any time — this only
  // changes what a synth request tries first, nothing is stored per-voice.
  voiceProvider String   @default("browser") // "browser" | "google"
  // Platform-wide dashboard color skin — see ColorSkin in src/lib/ai/model.ts
  // for the current option list and src/app/globals.css
  // .kb-shell[data-skin] for the actual palettes. Chosen once here, applies
  // to every tenant; not a per-user preference. The column default below is
  // never actually read — getPlatformColorSkin() falls back to its own
  // DEFAULT_SKIN constant ("jewel") whenever this row is unset or invalid.
  colorSkin     String   @default("default")
  updatedAt     DateTime @updatedAt

  @@map("platform_settings")
}

// One row per tenant per calendar month — tracks how many characters of
// premium (Google) voice a tenant has used, so the synth route can fall
// back to free browser voice once their plan's allowance for the period
// is spent instead of ever hard-blocking. `period` is "YYYY-MM"; a tenant
// simply gets a fresh row (and fresh allowance) the moment the month
// rolls over — no cron/reset job needed.
model VoiceUsage {
  id             String   @id @default(cuid())
  tenantId       String
  period         String
  charactersUsed Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, period])
  @@map("voice_usage")
}

// Every external-service credential this app can use, settable from
// /admin/api-keys instead of only an env var — a super-admin can add or
// rotate a key without a redeploy. `key` is one of the fixed identifiers
// in src/lib/platform/apiKeys.ts (e.g. "ANTHROPIC_API_KEY"); `valueEnc` is
// AES-256-GCM encrypted (src/lib/crypto.ts) since these are always secrets.
// Reading always checks here first, falling back to the env var of the
// same name — nothing breaks for a deployment that only ever used env vars.
model PlatformApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  valueEnc  String
  updatedAt DateTime @updatedAt

  @@map("platform_api_keys")
}

// A tenant's connected calendar — live two-way sync for reminders. One
// per tenant today (Google only); the provider field exists so Outlook
// can be added later without a schema change. Tokens are AES-256-GCM
// encrypted at rest, same as IMAP passwords (src/lib/crypto.ts).
model CalendarIntegration {
  id                   String    @id @default(cuid())
  tenantId             String    @unique
  tenant               Tenant    @relation(fields: [tenantId], references: [id])
  provider             String    @default("GOOGLE")
  refreshTokenEnc      String
  accessTokenEnc       String?
  accessTokenExpiresAt DateTime?
  calendarId           String    @default("primary")
  connectedByEmail     String? // whose Google account this is, shown in settings so it's obvious if the wrong person connected it
  createdAt            DateTime  @default(now())

  @@map("calendar_integrations")
}

// ============================================================================
// AGENT LAYER
// ============================================================================
// The agent is not a feature bolted next to the app — it is a second operator
// of the same Business Graph. That means it needs the three things any
// operator needs and a bolted-on chatbot doesn't: somewhere to remember, a
// record of what it did, and a defined limit on what it may do alone.

// How much this workspace lets the agent do without asking first. Deliberately
// per-tenant and not per-user: it is a statement about the business's appetite
// for autonomy, not one person's preference.
enum AgentAutonomy {
  SUGGEST_ONLY // never writes; proposes and waits
  REVERSIBLE // writes things that can be undone (drafts, tasks, notes)
  FULL // everything except money movement, which always asks
}

enum AgentRunTrigger {
  USER // someone typed or spoke a request
  SCHEDULE // the periodic tenant tick
  EVENT // something happened in the business
  AGENT // a named agent's own schedule
}

enum AgentRunStatus {
  RUNNING
  DONE
  FAILED
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

// One conversation. Threads are per-user so a follow-up ("do the same for
// Jane") resolves against what that person said, not the whole workspace.
model AgentThread {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  title     String?
  channel   String         @default("web") // web | whatsapp | voice
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  AgentMessage[]
  runs      AgentRun[]

  @@index([tenantId, userId])
  @@map("agent_threads")
}

model AgentMessage {
  id        String      @id @default(cuid())
  threadId  String
  thread    AgentThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String // user | assistant
  content   String
  createdAt DateTime    @default(now())

  @@index([threadId, createdAt])
  @@map("agent_messages")
}

// The audit trail for autonomy. Every run — typed, scheduled or event-driven —
// lands here with what it saw, what it decided and what it changed, so an
// action taken while nobody was watching is always attributable and, where
// the action supports it, undoable. This generalises the AiDraft queue, which
// only ever covered follow-up messages.
model AgentRun {
  id       String           @id @default(cuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  threadId String?
  thread   AgentThread?     @relation(fields: [threadId], references: [id])
  agentId  String?
  agent    AgentDefinition? @relation(fields: [agentId], references: [id])

  trigger        AgentRunTrigger
  status         AgentRunStatus  @default(RUNNING)
  // Who or what caused this. A user id for USER runs, an event id for EVENT
  // runs, null for the scheduled tick.
  actorUserId    String?
  input          String
  reply          String?
  // Ordered tool calls with their inputs and outputs, as JSON. This is what
  // the run detail page renders as "here is exactly what it did".
  steps          Json            @default("[]")
  // Set when the run stopped to ask. Holds the proposed tool calls so they
  // can be executed verbatim on approval rather than re-inferred.
  pendingActions Json?
  error          String?
  createdAt      DateTime        @default(now())
  finishedAt     DateTime?
  resolvedAt     DateTime?
  resolvedBy     String?

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("agent_runs")
}

// What the agent has learned about this workspace that isn't derivable from a
// query — payment habits, who to contact about what, standing instructions.
// Keyed so a fact can be updated rather than duplicated as it changes.
model TenantFact {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  value       String
  // Where this came from, so a wrong fact can be traced and removed.
  sourceRunId String?
  confidence  String   @default("observed") // observed | confirmed | stated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("tenant_facts")
}

// A named agent: a saved configuration of tools, autonomy and schedule. Once
// the runtime exists, "hire a collections agent" is a row here, not new code.
model AgentDefinition {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  // What this agent is for, in the owner's words. Goes into its system prompt.
  brief     String
  // Tool names it may use. Empty = every tool the triggering role allows.
  toolNames String[]      @default([])
  autonomy  AgentAutonomy @default(SUGGEST_ONLY)
  // Cron expression, evaluated by the tenant tick. Null = event/manual only.
  schedule  String?
  isActive  Boolean       @default(true)
  lastRunAt DateTime?
  createdAt DateTime      @default(now())
  runs      AgentRun[]

  @@index([tenantId, isActive])
  @@map("agent_definitions")
}

// Domain events emitted by the core layer. The agent subscribes to these so it
// reacts to the business changing, not only to the clock — a quote opened four
// times is a buying signal the moment it happens, not the next morning.
model DomainEvent {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        String // quote.opened_repeatedly, invoice.overdue, payment.failed, ...
  subjectType String
  subjectId   String
  payload     Json      @default("{}")
  createdAt   DateTime  @default(now())
  // Null until the agent has looked at it. The tick claims a batch atomically
  // by stamping this, so two overlapping ticks can't both react to one event.
  processedAt DateTime?

  @@index([tenantId, processedAt])
  @@index([type, createdAt])
  @@map("domain_events")
}
