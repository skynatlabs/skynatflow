{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/agent-tick",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/follow-ups",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/fetch-emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/recurring-invoices",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/webhook-dispatch",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/purge-deleted",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/bank-feeds",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/**": {
      "maxDuration": 300
    }
  }
}
