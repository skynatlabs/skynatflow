{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/agent-tick",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/follow-ups",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/appointment-reminders",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/fetch-emails",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/daily-briefing",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/recurring-invoices",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/webhook-dispatch",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "src/app/api/cron/**": {
      "maxDuration": 300
    }
  }
}
