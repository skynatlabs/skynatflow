# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
inspiration images/
pdf template designs/
.claude/launch.json

# Third-party HTML/Next templates kept locally for design reference only —
# not part of the app, and pulled into tsc/next build if left unignored.
/automation-saas/
/SassTech/
/admina-tailwind-admin/
/images /

# Capacitor / Android build output — generated, large, and regenerated by
# `npm run sync`. The native project itself IS committed, because it carries
# manifest edits, icons and theming that are real source.
mobile/node_modules/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
mobile/android/.idea/
mobile/android/app/release/
mobile/*.keystore
mobile/android/keystore.properties
mobile/android/*.keystore
mobile/android/app/build/
mobile/android/capacitor-cordova-android-plugins/build/
